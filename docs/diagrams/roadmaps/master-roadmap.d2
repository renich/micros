direction: down

classes: {
  complete: {
    style: {
      fill: "#e6f4ea"
      stroke: "#137333"
      stroke-width: 2
      border-radius: 6
    }
  }
  active: {
    style: {
      fill: "#e8f0fe"
      stroke: "#1a73e8"
      stroke-width: 2
      border-radius: 6
    }
  }
  future: {
    style: {
      fill: "#f8f9fa"
      stroke: "#5f6368"
      stroke-width: 1
      stroke-dash: 3
      border-radius: 6
    }
  }
}

p_foundations: "Phases 0-5: Proven Foundations (Complete)" {
  style: {
    fill: "#f1f3f4"
    stroke: "#80868b"
    stroke-width: 2
  }

  p0: "Phase 0: Direct-Syscall Sandbox\n(micros-init, msh, UKI)" { class: complete }
  p1: "Phase 1: Bare-Metal Substrate\n(UEFI boot.efi, PMM, VMM, IDT)" { class: complete }
  p2: "Phase 2: Language & Runtime\n(Macros, Immix GC, Stage 1)" { class: complete }
  p3: "Phase 3: Subsystems & Windowing\n(VirtIO, Compositor, Hierarchy)" { class: complete }
  p4: "Phase 4: Sovereign Cord-Cutting\n(PE Synthesizer, Dual-Slot A/B)" { class: complete }
  p5: "Phase 5: Decoupling & Ecosystem\n(Fast TCP, Git HTTP, netd, aid)" { class: complete }

  p0 -> p1 -> p2 -> p3 -> p4 -> p5
}

p6: "Phase 6: Pure Microkernel & Preemptive Multiprocessing (Complete)" {
  style: {
    fill: "#e6f4ea"
    stroke: "#137333"
    stroke-width: 2
  }

  m23a: "M23a: Hardware Ring 3 & Syscall Substrate\n(TSS, RSP0, LSTAR, CR3 Isolation)" { class: complete }
  m23b: "M23b: APIC Timer Preemption & SMP\n(1000Hz Tick, SIPI Multicore, MPSC Rings)" { class: complete }
  m24: "M24: Compositor & Input Decoupling\n(gopd, PS/2 Mouse, xHCI HID Pointer)" { class: complete }
  m25: "M25: Microkernel Storage Decoupling\n(storaged: NVMe/VirtIO, sys_dma_pin, CAS)" { class: complete }
  m26: "M26: Minimality Audit & Silicon Validation\n(21k LOC Ring 0 Freeze, ADR, Hardware Test)" { class: complete }

  m23a -> m23b -> m24 -> m25 -> m26
}

p7: "Phase 7: Declarative Hypermedia UI & Vector Graphics (Complete)" {
  style: {
    fill: "#e6f4ea"
    stroke: "#137333"
    stroke-width: 2
  }

  m27: "M27: Binary Hypermedia Streaming\n(uHTML, HyperTree IPC, Signals)" { class: complete }
  m28: "M28: Cached SDF Vector Rasterizer\n(Glyph Atlas, Bezier Curves, AABB)" { class: complete }
  m29: "M29: Sovereign Desktop Environment\n(desk.mx Multi-Window Glass Desktop)" { class: complete }

  m27 -> m28 -> m29
}

p8: "Phase 8: Autonomous P2P Federation & Distributed CAS (Complete)" {
  style: {
    fill: "#e6f4ea"
    stroke: "#137333"
    stroke-width: 2
  }

  m30: "M30: Sovereign P2P Wire Protocol\n(mTLS 1.3 / Noise Handshake)" { class: complete }
  m31: "M31: Distributed CAS & Merkle Sync\n(P2P BLAKE3 Chunks, CRDT/OCC Sync)" { class: complete }
  m32: "M32: Cryptographic Capability Delegation\n(Remote Actor Compute, Attenuation)" { class: complete }

  m30 -> m31 -> m32
}

p9: "Phase 9: In-System Self-Hosting & Silicon Independence (Complete)" {
  style: {
    fill: "#e6f4ea"
    stroke: "#137333"
    stroke-width: 2
  }

  m33: "M33: Pure In-System Native Compiler\n(Direct x86_64 Codegen, W^X)" { class: complete }
  m34: "M34: Sovereign Package Federation\n(Ed25519 Signatures, CAS Registry)" { class: complete }
  m35: "M35: Enterprise Bare-Metal Expansion\n(e1000/Realtek, Heterogeneous Silicon)" { class: complete }

  m33 -> m34 -> m35
}

p10: "Phase 10: Operational Hardening, Daemon Handoff & Cluster Mesh (Active Target)" {
  style: {
    fill: "#e8f0fe"
    stroke: "#1a73e8"
    stroke-width: 2
  }

  m36: "M36: Full Userland Daemon Handoff\n(gopd, storaged, netd, aid, p2pd, pkgd)" { class: complete }
  m37: "M37: Virtual P2P Cluster Mesh\n(Dual-Node QEMU, Discovery, Syscalls)" { class: complete }
  m38: "M38: Distributed CAS Wire Replication\n(Chunk Sync, BLAKE3, Port 8080)" { class: active }
  m39: "M39: Capability Delegation & Remote Actor\n(192-Byte Token, Gas Bounds)" { class: future }
  m40: "M40: Zero-Trust Hardening & Polish\n(IPC Fuzzing, Self-Healing, UX)" { class: future }

  m36 -> m37 -> m38 -> m39 -> m40
}

p_foundations.p5 -> p6.m23a
p6.m26 -> p7.m27: "Unblocks UI Engine"
p6.m26 -> p8.m30: "Unblocks P2P Networking"
p8.m31 -> p9.m33: "Unblocks Distributed Compiler"
p8.m32 -> p9.m34: "Unblocks Capability Distribution"
p9.m35 -> p10.m36: "Unblocks Operational Hardening"
