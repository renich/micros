// Syntactically Sweet Macros Demonstration (sweetness.mx)

fn greet(name) {
    greeting = "Hello, " + name + "!";
    println(greeting);
    return len(greeting);
}

fn count_evens(limit) {
    count = 0;
    i = 0;
    while (i <= limit) {
        if (i == 10) {
            println("Halfway milestone reached!");
        }
        count = count + 1;
        i = i + 2;
    }
    return count;
}

fn main() {
    println("--- MicrOS Macros Language Demo ---");
    greeting_len = greet("Rénich & Gemini");
    print("Greeting length: ");
    println(greeting_len);

    evens = count_evens(20);
    print("Total even numbers up to 20: ");
    println(evens);

    return evens;
}
