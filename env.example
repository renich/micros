# MicrOS (µOS) Environment Configuration Example
# Copy this file to .env and configure your resident AI provider credentials:
#   cp env.example .env

# AI Provider: gemini | openai | anthropic | local_http | mock
AI_PROVIDER=gemini

# API Key for cloud providers (Gemini, OpenAI, Anthropic)
GEMINI_API_KEY=

# Optional custom model (defaults: gemini-3.8-flash, gpt-4o, claude-3-5-sonnet-20241022)
# AI_MODEL=gemini-3.8-flash

# For offline or local LAN proxy (e.g. llama.cpp / Ollama):
# AI_PROVIDER=local_http
# AI_ENDPOINT=10.0.2.2
# AI_PORT=8080
# AI_USE_TLS=false
