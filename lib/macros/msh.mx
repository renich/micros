// MicrOS (µOS) MicroShell
// Stream-oriented CLI for humans and AI agents.

fn init_msh() {
    CLR_TEXT = 15132390;
    CLR_MUTED = 8226192;
    CLR_GREEN = 4057997;
    CLR_WARN = 15774780;
    CLR_CYAN = 3800806;
    CLR_BG = 0;
    msh_cur_x = 20;
    msh_cur_y = 36;
}

init_msh();

fn msh_draw_header() {
    sys_fb_draw_rect(0, 0, 1280, 24, 856343);
    sys_fb_draw_string(20, 4, "uOS MicroShell", CLR_TEXT, 856343);
    sys_fb_draw_string(1200, 4, "x86_64", CLR_MUTED, 856343);
    sys_fb_draw_rect(0, 24, 1280, 1, 2238254);
}

fn msh_clear_screen() {
    sys_fb_draw_rect(0, 25, 1280, 775, CLR_BG);
    msh_cur_x = 20;
    msh_cur_y = 36;
}

fn msh_newline() {
    msh_cur_x = 20;
    msh_cur_y = msh_cur_y + 16;
    if (msh_cur_y > 770) {
        msh_clear_screen();
    }
}

fn console_write(str) {
    sys_serial_write(str);
    slen = len(str);
    i = 0;
    while (i < slen) {
        ch = substr(str, i, i + 1);
        if (ch == "\r") {
            msh_cur_x = 20;
        } else if (ch == "\n") {
            msh_newline();
        } else {
            if (msh_cur_x + 8 > 1260) {
                msh_newline();
            }
            sys_fb_draw_string(msh_cur_x, msh_cur_y, ch, CLR_TEXT, CLR_BG);
            msh_cur_x = msh_cur_x + 8;
        }
        i = i + 1;
    }
}

fn console_writeln(str) {
    console_write(str + "\r\n");
}

fn is_prefix(str, pre) {
    slen = len(str);
    plen = len(pre);
    if (plen > slen) { return false; }
    return substr(str, 0, plen) == pre;
}

fn cmd_help() {
    console_writeln("-- MicrOS Command Reference --------------------");
    console_writeln("  help          - Show this command reference");
    console_writeln("  status        - System health and telemetry");
    console_writeln("  actors        - List registered actors and state");
    console_writeln("  clear         - Clear the terminal screen");
    console_writeln("  ls [prefix]   - List files in sovereign workspace");
    console_writeln("  cat <path>    - Read file from sovereign workspace");
    console_writeln("  write <p> <t> - Write text into workspace file");
    console_writeln("  rm <path>     - Delete file from workspace");
    console_writeln("  commit [msg]  - Snapshot workspace into CAS (OCC)");
    console_writeln("  workspace     - Show workspace status (ws)");
    console_writeln("  edit <path>   - Launch visual text editor (vedit)");
    console_writeln("  kill <id>     - Terminate actor by ID");
    console_writeln("  spawn <code>  - Spawn new actor from Macros code");
    console_writeln("  store <code>  - Store raw code or text into CAS");
    console_writeln("  fetch <hash>  - Retrieve payload from CAS by hash");
    console_writeln("  persist <id>  - Persist actor source to CAS root");
    console_writeln("  spawn_cas <h> - Spawn isolated actor from CAS hash");
    console_writeln("  harness       - Launch visual studio");
    console_writeln("  install       - Launch standalone silicon installer");
    console_writeln("  httpd         - Launch CAS-backed HTTP/1.1 web server");
    console_writeln("  rebuild       - Rebuild system kernel and stage to ESP");
    console_writeln("  reboot        - Reset system and reboot hardware");
    console_writeln("  exit          - Terminate MicroShell session");
}

fn cmd_status() {
    console_writeln("* Status    : Ready");
    console_writeln("* Actors    : " + int_to_str(sys_actor_count()) + " active");
    console_writeln("* Faults    : " + int_to_str(sys_fault_count()) + " contained");
    st = sys_catalog_status();
    if (len(st) > 0) {
        console_writeln("* Catalog   : " + st);
    }
}

fn cmd_actors() {
    total = sys_actor_count();
    console_writeln("Active Actor Domains: " + int_to_str(total));
    i = 0;
    while (i < 32) {
        st = sys_actor_state(i);
        if (st >= 0) {
            nm = sys_actor_name(i);
            st_str = "inactive";
            if (st == 1) { st_str = "ready"; }
            if (st == 2) { st_str = "running"; }
            if (st == 3) { st_str = "paused"; }
            if (st == 4) { st_str = "faulted"; }
            if (st == 5) { st_str = "stopped"; }
            console_writeln("  [" + int_to_str(i) + "] " + nm + " (" + st_str + ")");
        }
        i = i + 1;
    }
}

fn cmd_store(payload) {
    hash = sys_cas_put(payload);
    if (len(hash) == 0) {
        console_writeln("Storage error: Failed to store payload in CAS.");
        return 0;
    }
    console_writeln("Stored in CAS. Hash: " + hash);
    return 0;
}

fn cmd_fetch(hash) {
    content = sys_cas_get(hash);
    if (len(content) == 0) {
        console_writeln("Storage error: Hash not found in CAS: " + hash);
        return 0;
    }
    console_writeln("CAS Payload: " + content);
    return 0;
}

fn cmd_persist(target) {
    actor_id = str_to_int(target);
    hash = sys_actor_persist(actor_id);
    if (len(hash) == 0) {
        console_writeln("Storage error: Failed to persist Actor " + target);
        return 0;
    }
    console_writeln("Actor " + target + " persisted. Root Hash: " + hash);
    return 0;
}

fn cmd_spawn_cas(hash) {
    actor_id = sys_actor_spawn_cas(hash);
    if (actor_id < 0) {
        console_writeln("Storage error: Failed to spawn from CAS hash: " + hash);
        return 0;
    }
    console_writeln("Spawned Actor " + int_to_str(actor_id) + " from CAS");
    return 0;
}

fn cmd_spawn(code) {
    actor_id = sys_actor_spawn_code("worker", code);
    if (actor_id < 0) {
        console_writeln("Compilation error: Failed to spawn actor.");
        return 0;
    }
    console_writeln("Spawned Actor " + int_to_str(actor_id));
    return 0;
}

fn cmd_harness() {
    h_src = sys_bundle_read("harness.mx");
    if (len(h_src) == 0) {
        console_writeln("Error: harness.mx not found in genesis bundle.");
        return 0;
    }
    console_writeln("Launching Visual Studio...");
    sys_fb_clear(CLR_BG);
    h_id = sys_actor_spawn_code("harness", h_src);
    if (h_id < 0) {
        console_writeln("Error: Failed to spawn harness actor.");
        return 0;
    }
    sys_actor_wait(h_id);
    msh_draw_header();
    msh_clear_screen();
    console_writeln("Harness terminated. Returned to msh.");
    return 0;
}

fn cmd_install() {
    inst_src = sys_bundle_read("installer.mx");
    if (len(inst_src) == 0) {
        console_writeln("Error: installer.mx not found in genesis bundle.");
        return 0;
    }
    console_writeln("Launching Standalone Installer...");
    inst_id = sys_actor_spawn_code("installer", inst_src);
    if (inst_id < 0) {
        console_writeln("Error: Failed to spawn installer actor.");
        return 0;
    }
    sys_actor_wait(inst_id);
    msh_draw_header();
    msh_clear_screen();
    console_writeln("Installer terminated. Returned to msh.");
    return 0;
}

fn cmd_rebuild() {
    rebuild_src = sys_bundle_read("rebuild.mx");
    if (len(rebuild_src) == 0) {
        console_writeln("Error: rebuild.mx not found in genesis bundle.");
        return 0;
    }
    console_writeln("Initiating Autonomous Kernel Rebuild Pipeline...");
    r_id = sys_actor_spawn_code("rebuild", rebuild_src);
    if (r_id < 0) {
        console_writeln("Error: Failed to spawn rebuild actor.");
        return 0;
    }
    sys_actor_wait(r_id);
    console_writeln("Rebuild pipeline completed.");
    return 0;
}

fn cmd_httpd() {
    src = sys_bundle_read("http_server.mx");
    if (len(src) == 0) {
        console_writeln("Error: http_server.mx not found in genesis bundle.");
        return 0;
    }
    console_writeln("Launching CAS HTTP/1.1 Web Server...");
    h_id = sys_actor_spawn_code("httpd", src);
    if (h_id < 0) {
        console_writeln("Error: Failed to spawn httpd actor.");
        return 0;
    }
    console_writeln("HTTP Server Actor " + int_to_str(h_id) + " running on port 8080.");
    return 0;
}

fn cmd_reboot() {
    console_writeln("Restarting system...");
    sys_reboot();
    return 0;
}

fn cmd_ls(prefix) {
    list_str = sys_catalog_list(prefix);
    if (len(list_str) == 0) {
        console_writeln("(empty workspace)");
        return 0;
    }
    console_write(list_str);
    return 0;
}

fn cmd_cat(path) {
    if (len(path) == 0) {
        console_writeln("Usage: cat <path>");
        return 0;
    }
    content = sys_catalog_read(path);
    if (len(content) == 0) {
        console_writeln("Error: File not found or empty: " + path);
        return 0;
    }
    console_write(content);
    clen = len(content);
    if (substr(content, clen - 1, clen) != "\n") {
        console_writeln("");
    }
    return 0;
}

fn cmd_write(path, text) {
    hex = sys_catalog_write(path, text);
    if (len(hex) == 0) {
        console_writeln("Error: Write failed for " + path);
        return 0;
    }
    console_writeln("Wrote " + path + " (hash: " + substr(hex, 0, 16) + "...)");
    return 0;
}

fn cmd_write_parse(arg) {
    slen = len(arg);
    sp = 0 - 1;
    i = 0;
    while (i < slen) {
        if (substr(arg, i, i + 1) == " ") {
            if (sp < 0) { sp = i; }
        }
        i = i + 1;
    }
    if (sp < 0) {
        return cmd_write(arg, "");
    }
    p = substr(arg, 0, sp);
    t = substr(arg, sp + 1, slen);
    return cmd_write(p, t);
}

fn cmd_rm(path) {
    if (len(path) == 0) {
        console_writeln("Usage: rm <path>");
        return 0;
    }
    ok = sys_catalog_delete(path);
    if (ok) {
        console_writeln("Deleted " + path);
    } else {
        console_writeln("Error: File not found or delete failed: " + path);
    }
    return 0;
}

fn cmd_commit(msg) {
    if (len(msg) == 0) { msg = "workspace snapshot"; }
    root = sys_catalog_commit(msg);
    if (len(root) == 0) {
        console_writeln("Error: Commit failed.");
        return 0;
    }
    console_writeln("Committed workspace root: " + root);
    return 0;
}

fn cmd_workspace() {
    st = sys_catalog_status();
    console_writeln("Workspace Status: " + st);
    return 0;
}

fn cmd_edit(path) {
    if (len(path) == 0) {
        console_writeln("Usage: edit <path>");
        return 0;
    }
    sys_catalog_write(".vedit_target", path);
    src = sys_bundle_read("vedit.mx");
    if (len(src) == 0) {
        console_writeln("Error: vedit.mx not found in genesis bundle.");
        return 0;
    }
    console_writeln("Launching Visual Text Editor for " + path + "...");
    sys_fb_clear(CLR_BG);
    id = sys_actor_spawn_code("vedit", src);
    if (id < 0) {
        console_writeln("Error: Failed to spawn vedit actor.");
        return 0;
    }
    sys_actor_wait(id);
    msh_draw_header();
    msh_clear_screen();
    console_writeln("Editor session finished. Returned to msh.");
    return 0;
}

fn eval_workspace_cmd(cmd) {
    if (cmd == "ls") { return cmd_ls(""); }
    if (is_prefix(cmd, "ls ")) { return cmd_ls(substr(cmd, 3, len(cmd))); }
    if (is_prefix(cmd, "cat ")) { return cmd_cat(substr(cmd, 4, len(cmd))); }
    if (is_prefix(cmd, "write ")) { return cmd_write_parse(substr(cmd, 6, len(cmd))); }
    if (is_prefix(cmd, "rm ")) { return cmd_rm(substr(cmd, 3, len(cmd))); }
    if (cmd == "commit") { return cmd_commit(""); }
    if (is_prefix(cmd, "commit ")) { return cmd_commit(substr(cmd, 7, len(cmd))); }
    if (cmd == "workspace") { return cmd_workspace(); }
    if (cmd == "ws") { return cmd_workspace(); }
    if (is_prefix(cmd, "edit ")) { return cmd_edit(substr(cmd, 5, len(cmd))); }
    return 0 - 1;
}

fn eval_command(cmd) {
    ws_res = eval_workspace_cmd(cmd);
    if (ws_res >= 0) { return ws_res; }
    if (cmd == "help") { return cmd_help(); }
    if (cmd == "status") { return cmd_status(); }
    if (cmd == "actors") { return cmd_actors(); }
    if (cmd == "clear") {
        sys_serial_write(char_to_str(27) + "[2J" + char_to_str(27) + "[H");
        msh_clear_screen();
        return 0;
    }
    if (cmd == "harness") { return cmd_harness(); }
    if (cmd == "install") { return cmd_install(); }
    if (cmd == "httpd") { return cmd_httpd(); }
    if (cmd == "rebuild") { return cmd_rebuild(); }
    if (cmd == "reboot") { return cmd_reboot(); }
    if (is_prefix(cmd, "spawn ")) { return cmd_spawn(substr(cmd, 6, len(cmd))); }
    if (is_prefix(cmd, "store ")) { return cmd_store(substr(cmd, 6, len(cmd))); }
    if (is_prefix(cmd, "fetch ")) { return cmd_fetch(substr(cmd, 6, len(cmd))); }
    if (is_prefix(cmd, "persist ")) { return cmd_persist(substr(cmd, 8, len(cmd))); }
    if (is_prefix(cmd, "spawn_cas ")) { return cmd_spawn_cas(substr(cmd, 10, len(cmd))); }
    if (is_prefix(cmd, "kill ")) {
        target_s = substr(cmd, 5, len(cmd));
        target_id = str_to_int(target_s);
        if (target_id < 0) {
            console_writeln("Error: Invalid actor ID '" + target_s + "'");
            return 0;
        }
        sys_actor_terminate(target_id);
        console_writeln("Terminated Actor " + target_s);
        return 0;
    }
    console_writeln("Unknown command: '" + cmd + "' (type 'help')");
    return 0;
}

fn poll_char() {
    c = sys_serial_read();
    if (c >= 0) { return c; }
    return sys_kbd_read();
}

fn draw_prompt() {
    sys_serial_write("msh> ");
    sys_fb_draw_string(msh_cur_x, msh_cur_y, "msh> ", CLR_GREEN, CLR_BG);
    msh_cur_x = msh_cur_x + 40;
}

fn handle_newline(buf) {
    sys_serial_write("\r\n");
    msh_newline();
    if (len(buf) > 0) {
        if (buf == "exit") {
            console_writeln("Exiting MicroShell.");
            return false;
        }
        if (buf == "quit") {
            console_writeln("Exiting MicroShell.");
            return false;
        }
        eval_command(buf);
    }
    return true;
}

fn handle_backspace(buf) {
    if (len(buf) > 0) {
        sys_serial_write(char_to_str(8) + " " + char_to_str(8));
        if (msh_cur_x >= 28) {
            msh_cur_x = msh_cur_x - 8;
            sys_fb_draw_rect(msh_cur_x, msh_cur_y, 8, 16, CLR_BG);
        }
        return substr(buf, 0, len(buf) - 1);
    }
    return buf;
}

fn handle_printable(buf, c) {
    ch_str = char_to_str(c);
    sys_serial_write(ch_str);
    if (msh_cur_x + 8 > 1260) {
        msh_newline();
    }
    sys_fb_draw_string(msh_cur_x, msh_cur_y, ch_str, CLR_TEXT, CLR_BG);
    msh_cur_x = msh_cur_x + 8;
    return buf + ch_str;
}

fn msh_loop() {
    line_buf = "";
    last_char = 0;
    running = true;
    draw_prompt();
    while (running) {
        c = poll_char();
        if (c < 0) {
            sys_yield();
        } else if (c == 10) {
            if (last_char != 13) {
                running = handle_newline(line_buf);
                line_buf = "";
                if (running) { draw_prompt(); }
            }
            last_char = 10;
        } else if (c == 13) {
            running = handle_newline(line_buf);
            line_buf = "";
            if (running) { draw_prompt(); }
            last_char = 13;
        } else if (c == 8) {
            line_buf = handle_backspace(line_buf);
            last_char = 8;
        } else if (c == 127) {
            line_buf = handle_backspace(line_buf);
            last_char = 127;
        } else if (c >= 32) {
            if (c <= 126) {
                line_buf = handle_printable(line_buf, c);
            }
            last_char = c;
        }
    }
}

fn msh_main() {
    msh_draw_header();
    msh_clear_screen();
    console_writeln("MicroShell 0.15.0");
    console_writeln("Type 'help' for commands.");
    console_writeln("");
    msh_loop();
}

msh_main();
