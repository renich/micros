fn cmd_files(prefix) {
    list = sys_catalog_list(prefix);
    if (len(list) == 0) {
        console_writeln("-- Genesis Bundle Modules ----------------------", CLR_MUTED);
        console_writeln("  init.mx, msh.mx, harness.mx, installer.mx", CLR_TEXT);
        console_writeln("  lexer.mx, parser.mx, compiler.mx, bundle.mx", CLR_TEXT);
        console_writeln("  rebuild.mx, http_server.mx, vedit.mx", CLR_TEXT);
    } else {
        console_writeln("-- Workspace Files -----------------------------", CLR_MUTED);
        console_writeln(list, CLR_TEXT);
    }
    return 0;
}

fn cmd_cat(path) {
    if (len(path) == 0) {
        console_writeln("Usage: /cat <path>", CLR_WARN);
        return 0;
    }
    content = sys_catalog_read(path);
    if (len(content) == 0) { content = sys_bundle_read(path); }
    if (len(content) == 0) {
        console_writeln("File not found: " + path, CLR_WARN);
    } else {
        console_writeln("--- File: " + path + " (" + int_to_str(len(content)) + " bytes) ---", CLR_MUTED);
        console_writeln(content, CLR_TEXT);
    }
    return 0;
}

fn cmd_run(arg) {
    if (len(arg) == 0) {
        if (len(last_resp_code) == 0) {
            console_writeln("Usage: /run <path> or /run (execute synthesized code)", CLR_WARN);
            return 0;
        }
        console_writeln("[harness] Executing synthesized code...", CLR_GREEN);
        id = sys_actor_spawn_code("ai_task", last_resp_code);
        if (id < 0) {
            console_writeln("Error: Failed to compile/spawn synthesized code.", CLR_WARN);
        } else {
            console_writeln("Spawned Actor " + int_to_str(id) + " (ai_task)", CLR_GREEN);
            render_inspector();
        }
        return 0;
    }
    src = sys_catalog_read(arg);
    if (len(src) == 0) { src = sys_bundle_read(arg); }
    if (len(src) == 0) {
        console_writeln("Error: File not found: " + arg, CLR_WARN);
        return 0;
    }
    id = sys_actor_spawn_code(arg, src);
    if (id < 0) {
        console_writeln("Error: Failed to spawn " + arg, CLR_WARN);
    } else {
        console_writeln("Spawned Actor " + int_to_str(id) + " (" + arg + ")", CLR_GREEN);
        render_inspector();
    }
    return 0;
}

