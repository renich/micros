fn cmd_status() {
    console_writeln("* Agent     : Online (harness mode)", CLR_GREEN);
    console_writeln("* Model     : Gemini 3.8 Flash (Sovereign ABI)", CLR_ACCENT);
    console_writeln("* Actors    : " + int_to_str(sys_actor_count()) + " active", CLR_TEXT);
    console_writeln("* Faults    : " + int_to_str(sys_fault_count()) + " contained", CLR_TEXT);
}

fn cmd_model() {
    console_writeln("Active AI Provider: Gemini (TLS 1.3)", CLR_ACCENT);
    console_writeln("Model Identifier  : gemini-3.8-flash", CLR_TEXT);
    console_writeln("Thinking Level    : Low (zero-alloc streaming)", CLR_MUTED);
    return 0;
}

fn cmd_history() {
    console_writeln("-- Prompt History ------------------------------", CLR_MUTED);
    hlen = len(prompt_history);
    if (hlen == 0) {
        console_writeln("  (no user prompts recorded)", CLR_TEXT);
        return 0;
    }
    hi = 0;
    while (hi < hlen) {
        console_writeln("  [" + int_to_str(hi + 1) + "] " + prompt_history[hi], CLR_TEXT);
        hi = hi + 1;
    }
    return 0;
}

fn cmd_reset() {
    conv_history = [];
    prompt_history = [];
    compressed_summary = "";
    cmd_clear();
    console_writeln("[harness] Conversation context reset.", CLR_GREEN);
    return 0;
}

fn cmd_conversations() {
    console_writeln("-- Active Conversations ------------------------", CLR_MUTED);
    ci = 0;
    clen = len(conversations);
    while (ci < clen) {
        prefix = "  [";
        if (ci == conv_active_idx) { prefix = "* ["; }
        console_writeln(prefix + int_to_str(ci + 1) + "] " + conversations[ci], CLR_TEXT);
        ci = ci + 1;
    }
    return 0;
}

fn cmd_new_conv(title) {
    t = title;
    if (len(t) == 0) {
        t = "Chat " + int_to_str(len(conversations) + 1);
    }
    conv_stores[conv_active_idx] = chat_lines;
    conv_color_stores[conv_active_idx] = chat_colors;
    conv_prompt_stores[conv_active_idx] = conv_history;

    conversations = push(conversations, t);
    conv_stores = push(conv_stores, []);
    conv_color_stores = push(conv_color_stores, []);
    conv_prompt_stores = push(conv_prompt_stores, []);
    conv_active_idx = len(conversations) - 1;

    chat_lines = [];
    chat_colors = [];
    conv_history = [];
    compressed_summary = "";

    render_chat();
    draw_header();
    console_writeln("[harness] New conversation created: " + t, CLR_GREEN);
    return 0;
}

fn cmd_switch_conv(id_s) {
    target_idx = str_to_int(id_s) - 1;
    if (target_idx < 0) {
        console_writeln("Usage: /switch <id>", CLR_WARN);
        return 0;
    }
    if (target_idx >= len(conversations)) {
        console_writeln("Error: Conversation " + id_s + " does not exist.", CLR_WARN);
        return 0;
    }
    if (target_idx == conv_active_idx) {
        console_writeln("Already in conversation " + id_s, CLR_MUTED);
        return 0;
    }
    conv_stores[conv_active_idx] = chat_lines;
    conv_color_stores[conv_active_idx] = chat_colors;
    conv_prompt_stores[conv_active_idx] = conv_history;

    conv_active_idx = target_idx;
    chat_lines = conv_stores[target_idx];
    chat_colors = conv_color_stores[target_idx];
    conv_history = conv_prompt_stores[target_idx];
    compressed_summary = "";

    render_chat();
    draw_header();
    console_writeln("[harness] Switched to conversation: " + conversations[target_idx], CLR_GREEN);
    return 0;
}

fn cmd_search(query) {
    if (len(query) == 0) {
        console_writeln("Usage: /search <query>", CLR_WARN);
        return 0;
    }
    console_writeln("-- Search Results for '" + query + "' -----------", CLR_MUTED);
    matches = 0;
    si = 0;
    tot = len(chat_lines);
    while (si < tot) {
        pos = find_str(chat_lines[si], query);
        if (pos >= 0) {
            matches = matches + 1;
            console_writeln("  [" + int_to_str(si + 1) + "] " + chat_lines[si], CLR_TEXT);
        }
        si = si + 1;
    }
    if (matches == 0) {
        console_writeln("  (no matches found in current chat)", CLR_MUTED);
    } else {
        console_writeln("Found " + int_to_str(matches) + " match(es).", CLR_GREEN);
    }
    return 0;
}

fn cmd_copy(arg) {
    if (arg == "code") {
        if (len(last_resp_code) == 0) {
            console_writeln("[harness] No synthesized code in last turn.", CLR_WARN);
            return 0;
        }
        clipboard_buf = last_resp_code;
        console_writeln("[harness] Code copied to clipboard (" + int_to_str(len(clipboard_buf)) + " chars).", CLR_GREEN);
        render_inspector();
        return 0;
    }
    if (len(last_resp_text) == 0) {
        console_writeln("[harness] No assistant response to copy.", CLR_WARN);
        return 0;
    }
    clipboard_buf = last_resp_text;
    console_writeln("[harness] Response copied to clipboard (" + int_to_str(len(clipboard_buf)) + " chars).", CLR_GREEN);
    render_inspector();
    return 0;
}

fn cmd_paste() {
    if (len(clipboard_buf) == 0) {
        console_writeln("[harness] Clipboard is empty.", CLR_WARN);
        return 0;
    }
    left = substr(line_buf, 0, line_pos);
    right = substr(line_buf, line_pos, len(line_buf));
    line_buf = left + clipboard_buf + right;
    line_pos = line_pos + len(clipboard_buf);
    render_prompt();
    return 0;
}

fn cmd_compress() {
    hlen = len(conv_history);
    if (hlen <= 2) {
        console_writeln("[harness] Context is already minimal (" + int_to_str(hlen) + " turns).", CLR_MUTED);
        return 0;
    }
    old_size = 0;
    ci = 0;
    topics = "";
    while (ci < hlen - 2) {
        msg = conv_history[ci];
        old_size = old_size + len(msg);
        if (len(msg) > 30) { msg = substr(msg, 0, 30) + "..."; }
        if (len(topics) > 0) { topics = topics + " | "; }
        topics = topics + msg;
        ci = ci + 1;
    }
    compressed_summary = "[Summary of turns 1.." + int_to_str(hlen - 2) + ": " + topics + "]";
    new_h = [];
    new_h = push(new_h, conv_history[hlen - 2]);
    new_h = push(new_h, conv_history[hlen - 1]);
    conv_history = new_h;
    saved = old_size - len(compressed_summary);
    if (saved < 0) { saved = 0; }
    console_writeln("[harness] Context compressed (" + int_to_str(hlen - 2) + " turns condensed, " + int_to_str(saved) + " chars saved).", CLR_GREEN);
    return 0;
}

fn auto_compress_context() {
    if (len(conv_history) > 6) {
        cmd_compress();
    }
}

fn build_prompt_with_context(prompt) {
    if (len(compressed_summary) > 0) {
        return compressed_summary + "\n\nUser: " + prompt;
    }
    return prompt;
}

fn state_name(st) {
    if (st == 1) { return "ready"; }
    if (st == 2) { return "running"; }
    if (st == 3) { return "paused"; }
    if (st == 4) { return "faulted"; }
    if (st == 5) { return "stopped"; }
    return "inactive";
}

fn pad_right_18(str) {
    pad = 18 - len(str);
    res = str;
    while (pad > 0) {
        res = res + " ";
        pad = pad - 1;
    }
    return res;
}

fn cmd_actors() {
    console_writeln("------------------------------------------------", CLR_BORDER);
    console_writeln(" ID  Name               State", CLR_MUTED);
    console_writeln("------------------------------------------------", CLR_BORDER);
    aid = 0;
    while (aid < 8) {
        ast = sys_actor_state(aid);
        if (ast >= 0) {
            id_s = int_to_str(aid);
            if (len(id_s) == 1) { id_s = " " + id_s; }
            nm = pad_right_18(sys_actor_name(aid));
            console_writeln(" " + id_s + "  " + nm + " " + state_name(ast), CLR_TEXT);
        }
        aid = aid + 1;
    }
    console_writeln("------------------------------------------------", CLR_BORDER);
}

fn cmd_ai(prompt) {
    conv_history = push(conv_history, prompt);
    auto_compress_context();
    console_writeln("[harness] Thinking...", CLR_MUTED);
    payload = build_prompt_with_context(prompt);
    resp = sys_ai_prompt(payload);
    if (len(resp) == 0) {
        console_writeln("[harness] Offline or auth failure (check network / API key).", CLR_WARN);
        return 0;
    }
    last_resp_text = resp;
    last_resp_code = extract_code(resp);
    turn = 0;
    while (turn < 5) {
        tool_res = sys_ai_tool_call(resp);
        if (len(tool_res) == 0) {
            turn = 999;
        } else {
            console_writeln("● " + tool_res, CLR_GREEN);
            render_inspector();
            resp = sys_ai_prompt("Tool result: " + tool_res + ". Continue task or provide final summary.");
            if (len(resp) == 0) {
                console_writeln("[harness] Follow-up turn failed.", CLR_WARN);
                return 0;
            }
            last_resp_text = resp;
            c_ext = extract_code(resp);
            if (len(c_ext) > 0) { last_resp_code = c_ext; }
            turn = turn + 1;
        }
    }
    console_write("harness> ", CLR_GREEN);
    console_print_wrapped(resp, CLR_TEXT);
    code = last_resp_code;
    if (len(code) > 0) {
        console_writeln("[harness] Synthesized Actor code detected. Spawning...", CLR_GREEN);
        actor_id = sys_actor_spawn_code("child_worker", code);
        if (actor_id < 0) {
            console_writeln("[kernel] Failed to compile or spawn actor from AI code.", CLR_WARN);
        } else {
            console_writeln("  └─> Spawned dynamic Actor " + int_to_str(actor_id), CLR_GREEN);
            render_inspector();
        }
    }
    return 0;
}

fn cmd_store(code) {
    hash = sys_cas_put(code);
    if (len(hash) == 0) {
        console_writeln("Storage error: Failed to store in CAS.", CLR_WARN);
        return 0;
    }
    console_writeln("Stored in CAS. Hash: " + hash, CLR_GREEN);
    return 0;
}

fn cmd_fetch(hash) {
    content = sys_cas_get(hash);
    if (len(content) == 0) {
        console_writeln("CAS chunk not found: " + hash, CLR_WARN);
    } else {
        console_writeln("--- CAS Payload ---", CLR_MUTED);
        console_writeln(content, CLR_TEXT);
    }
    return 0;
}

fn cmd_persist(target) {
    hash = sys_actor_persist(str_to_int(target));
    if (len(hash) == 0) {
        console_writeln("Storage error: Failed to persist Actor " + target, CLR_WARN);
        return 0;
    }
    console_writeln("Actor " + target + " persisted. Root Hash: " + hash, CLR_GREEN);
    return 0;
}

fn cmd_spawn_cas(hash) {
    actor_id = sys_actor_spawn_cas(hash);
    if (actor_id < 0) {
        console_writeln("Storage error: Failed to spawn from CAS hash: " + hash, CLR_WARN);
        return 0;
    }
    console_writeln("Spawned Actor " + int_to_str(actor_id) + " from CAS", CLR_GREEN);
    render_inspector();
    return 0;
}

fn eval_layout(lang) {
    if (lang == "es") {
        sys_kbd_layout(1);
        console_writeln("Keyboard layout set to ES-LATAM", CLR_GREEN);
    } else if (lang == "us") {
        sys_kbd_layout(0);
        console_writeln("Keyboard layout set to US-QWERTY", CLR_GREEN);
    } else {
        console_writeln("Unknown layout. Use '/layout es' or '/layout us'", CLR_WARN);
    }
    return 0;
}

fn eval_command(cmd) {
    if (cmd == "/help") { return cmd_help(); }
    if (cmd == "help") { return cmd_help(); }
    if (cmd == "/status") { return cmd_status(); }
    if (cmd == "status") { return cmd_status(); }
    if (cmd == "/actors") { return cmd_actors(); }
    if (cmd == "actors") { return cmd_actors(); }
    if (cmd == "/clear") { return cmd_clear(); }
    if (cmd == "clear") { return cmd_clear(); }
    if (cmd == "/history") { return cmd_history(); }
    if (cmd == "history") { return cmd_history(); }
    if (cmd == "/reset") { return cmd_reset(); }
    if (cmd == "reset") { return cmd_reset(); }
    if (cmd == "/model") { return cmd_model(); }
    if (cmd == "model") { return cmd_model(); }
    if (cmd == "/chats") { return cmd_conversations(); }
    if (cmd == "/conversations") { return cmd_conversations(); }
    if (cmd == "/compress") { return cmd_compress(); }
    if (cmd == "/paste") { return cmd_paste(); }
    if (cmd == "/copy") { return cmd_copy(""); }
    if (cmd == "/copy code") { return cmd_copy("code"); }
    if (is_prefix(cmd, "/copy ")) { return cmd_copy(substr(cmd, 6, len(cmd))); }
    if (is_prefix(cmd, "/new ")) { return cmd_new_conv(substr(cmd, 5, len(cmd))); }
    if (cmd == "/new") { return cmd_new_conv(""); }
    if (is_prefix(cmd, "/switch ")) { return cmd_switch_conv(substr(cmd, 8, len(cmd))); }
    if (is_prefix(cmd, "/search ")) { return cmd_search(substr(cmd, 8, len(cmd))); }
    if (is_prefix(cmd, "/find ")) { return cmd_search(substr(cmd, 6, len(cmd))); }
    if (is_prefix(cmd, "store ")) { return cmd_store(substr(cmd, 6, len(cmd))); }
    if (is_prefix(cmd, "fetch ")) { return cmd_fetch(substr(cmd, 6, len(cmd))); }
    if (is_prefix(cmd, "persist ")) { return cmd_persist(substr(cmd, 8, len(cmd))); }
    if (is_prefix(cmd, "spawn_cas ")) { return cmd_spawn_cas(substr(cmd, 10, len(cmd))); }
    if (is_prefix(cmd, "/layout ")) { return eval_layout(substr(cmd, 8, len(cmd))); }
    if (is_prefix(cmd, "layout ")) { return eval_layout(substr(cmd, 7, len(cmd))); }
    if (is_prefix(cmd, "/kill ")) {
        target = substr(cmd, 6, len(cmd));
        sys_actor_terminate(str_to_int(target));
        console_writeln("Terminated Actor " + target, CLR_WARN);
        render_inspector();
        return 0;
    }
    if (is_prefix(cmd, "kill ")) {
        target = substr(cmd, 5, len(cmd));
        sys_actor_terminate(str_to_int(target));
        console_writeln("Terminated Actor " + target, CLR_WARN);
        render_inspector();
        return 0;
    }
    
    return cmd_ai(cmd);
}

fn render_prompt() {
    sys_fb_draw_rect(20, PROMPT_Y, 835, 16, CLR_BG);
    prompt_str = "harness> ";
    if (vim_mode == 1) {
        prompt_str = "harness:norm> ";
    }
    sys_fb_draw_string(20, PROMPT_Y, prompt_str, CLR_ACCENT, CLR_BG);
    prompt_offset = 20 + len(prompt_str) * 8;
    sys_fb_draw_string(prompt_offset, PROMPT_Y, line_buf, CLR_TEXT, CLR_BG);
    
    cur_px = prompt_offset + line_pos * 8;
    if (vim_mode == 0) {
        sys_fb_draw_rect(cur_px, PROMPT_Y, 2, 16, CLR_GREEN);
    } else {
        sys_fb_draw_rect(cur_px, PROMPT_Y, 8, 16, CLR_MUTED);
        if (line_pos < len(line_buf)) {
            ch = substr(line_buf, line_pos, line_pos + 1);
            sys_fb_draw_string(cur_px, PROMPT_Y, ch, CLR_BG, CLR_MUTED);
        }
    }
    
    esc = char_to_str(27);
    cr = char_to_str(13);
    sys_serial_write(cr + esc + "[K" + ANSI_BOLD + ANSI_CYAN + prompt_str + ANSI_RESET + line_buf);
    back_steps = len(line_buf) - line_pos;
    if (back_steps > 0) {
        sys_serial_write(esc + "[" + int_to_str(back_steps) + "D");
    }
}

fn poll_char() {
    c = sys_serial_read();
    if (c >= 0) { return c; }
    return sys_kbd_read();
}

fn handle_newline() {
    console_writeln("user> " + line_buf, CLR_ACCENT);
    if (len(line_buf) > 0) {
        if (line_buf == "/exit") {
            console_writeln("Halting harness. Returning to msh.", CLR_MUTED);
            return false;
        }
        if (line_buf == "exit") {
            console_writeln("Halting harness. Returning to msh.", CLR_MUTED);
            return false;
        }
        if (line_buf == "/quit") {
            console_writeln("Halting harness. Returning to msh.", CLR_MUTED);
            return false;
        }
        if (line_buf == "quit") {
            console_writeln("Halting harness. Returning to msh.", CLR_MUTED);
            return false;
        }
        prompt_history = push(prompt_history, line_buf);
        hist_pos = 0 - 1;
        saved_draft = "";
        eval_command(line_buf);
    }
    line_buf = "";
    line_pos = 0;
    vim_mode = 0;
    return true;
}

fn handle_backspace() {
    if (line_pos > 0) {
        left = substr(line_buf, 0, line_pos - 1);
        right = substr(line_buf, line_pos, len(line_buf));
        line_buf = left + right;
        line_pos = line_pos - 1;
    }
}

fn handle_printable(c) {
    ch_str = char_to_str(c);
    left = substr(line_buf, 0, line_pos);
    right = substr(line_buf, line_pos, len(line_buf));
    line_buf = left + ch_str + right;
    line_pos = line_pos + 1;
}

fn handle_vim_key(c) {
    if (c == 105) { vim_mode = 0; return 0; } // i
    if (c == 97) { // a
        vim_mode = 0;
        if (line_pos < len(line_buf)) { line_pos = line_pos + 1; }
        return 0;
    }
    if (c == 73) { vim_mode = 0; line_pos = 0; return 0; } // I
    if (c == 65) { vim_mode = 0; line_pos = len(line_buf); return 0; } // A
    if (c == 104) { if (line_pos > 0) { line_pos = line_pos - 1; } return 0; } // h
    if (c == 108) { if (line_pos < len(line_buf)) { line_pos = line_pos + 1; } return 0; } // l
    if (c == 107) { hist_prev(); return 0; } // k
    if (c == 106) { hist_next(); return 0; } // j
    if (c == 119) { jump_word_forward(); return 0; } // w
    if (c == 98) { jump_word_backward(); return 0; } // b
    if (c == 48) { line_pos = 0; return 0; } // 0
    if (c == 36) { // $
        if (len(line_buf) > 0) { line_pos = len(line_buf) - 1; }
        return 0;
    }
    if (c == 120) { delete_char_at_cursor(); return 0; } // x
    if (c == 100) { line_buf = ""; line_pos = 0; return 0; } // d
    if (c == 99) { line_buf = ""; line_pos = 0; vim_mode = 0; return 0; } // c
    if (c == 112) { cmd_paste(); return 0; } // p
    if (c == 47) { // /
        vim_mode = 0;
        line_buf = "/search ";
        line_pos = 8;
        return 0;
    }
    return 0;
}

fn harness_loop() {
    running = true;
    render_prompt();
    while (running) {
        c = poll_char();
        if (c < 0) {
            sys_yield();
        } else if (c == 256) { // UP
            hist_prev(); render_prompt();
        } else if (c == 257) { // DOWN
            hist_next(); render_prompt();
        } else if (c == 258) { // LEFT
            if (line_pos > 0) { line_pos = line_pos - 1; }
            render_prompt();
        } else if (c == 259) { // RIGHT
            if (line_pos < len(line_buf)) { line_pos = line_pos + 1; }
            render_prompt();
        } else if (c == 262) { // HOME
            line_pos = 0; render_prompt();
        } else if (c == 263) { // END
            line_pos = len(line_buf); render_prompt();
        } else if (c == 265) { // DELETE
            delete_char_at_cursor(); render_prompt();
        } else if (c == 27) { // ESCAPE
            vim_mode = 1;
            if (line_pos > 0) { line_pos = line_pos - 1; }
            render_prompt();
        } else if (c == 10) { // ENTER
            running = handle_newline();
            if (running) { render_prompt(); }
        } else if (c == 13) { // ENTER
            running = handle_newline();
            if (running) { render_prompt(); }
        } else if (c == 8) { // BACKSPACE
            if (vim_mode == 0) { handle_backspace(); render_prompt(); }
        } else if (c == 127) { // BACKSPACE
            if (vim_mode == 0) { handle_backspace(); render_prompt(); }
        } else if (c == 1) { // Ctrl+A
            line_pos = 0; render_prompt();
        } else if (c == 5) { // Ctrl+E
            line_pos = len(line_buf); render_prompt();
        } else if (c == 2) { // Ctrl+B
            if (line_pos > 0) { line_pos = line_pos - 1; }
            render_prompt();
        } else if (c == 6) { // Ctrl+F
            if (line_pos < len(line_buf)) { line_pos = line_pos + 1; }
            render_prompt();
        } else if (c == 16) { // Ctrl+P
            hist_prev(); render_prompt();
        } else if (c == 14) { // Ctrl+N
            hist_next(); render_prompt();
        } else if (c == 11) { // Ctrl+K
            line_buf = substr(line_buf, 0, line_pos); render_prompt();
        } else if (c == 21) { // Ctrl+U
            line_buf = substr(line_buf, line_pos, len(line_buf));
            line_pos = 0; render_prompt();
        } else if (c == 23) { // Ctrl+W
            delete_word_backward(); render_prompt();
        } else if (c == 12) { // Ctrl+L
            render_chat(); render_inspector(); render_prompt();
        } else if (c == 3) { // Ctrl+C
            line_buf = ""; line_pos = 0; hist_pos = 0 - 1;
            console_writeln("^C", CLR_MUTED); render_prompt();
        } else if (c == 25) { // Ctrl+Y
            cmd_paste();
        } else if (c >= 32) {
            if (vim_mode == 1) {
                handle_vim_key(c);
            } else {
                handle_printable(c);
            }
            render_prompt();
        }
    }
}

fn harness_main() {
    init_theme();
    init_ansi();
    sys_fb_clear(CLR_BG);
    draw_header();
    draw_panels();
    render_inspector();
    console_writeln("uOS Autonomous Agent Studio (harness)", CLR_ACCENT);
    console_writeln("Resident AI: Gemini 3.8 Flash | Protocol: Sovereign ABI", CLR_MUTED);
    console_writeln("Type /help for commands. Unprefixed text is sent to AI Agent.", CLR_MUTED);
    console_writeln("------------------------------------------------", CLR_BORDER);
    harness_loop();
    sys_fb_clear(CLR_BG);
    return 0;
}

harness_main();
