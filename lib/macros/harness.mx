// MicrOS (µOS) Interactive Actor Harness
// Standalone terminal interface running inside Actor 0.
// Provides live status, vector canvas rendering, actor inspection, and command loop.

fn init_theme() {
    CLR_BG = 0;             // Pure pitch black: 0x000000
    CLR_HEADER_BG = 856343; // Dark charcoal header: 0x0D1117
    CLR_BORDER = 2238254;   // Hairline graphite border: 0x22272E
    CLR_TEXT = 15132390;    // Crisp neutral white: 0xE6EDF3
    CLR_MUTED = 8226192;    // Refined slate gray: 0x7D8590
    CLR_ACCENT = 5809919;   // Ice sapphire blue: 0x58A6FF
    CLR_GREEN = 4176208;    // Emerald green: 0x3FB950
    CLR_WARN = 13801762;    // Amber: 0xD29922
    
    // Chat History State
    chat_lines = [];
    chat_colors = [];
    cur_line_text = "";
    cur_line_color = CLR_TEXT;
    conv_history = [];
    
    PROMPT_Y = 750;
}

fn init_ansi() {
    ESC = char_to_str(27);
    ANSI_RESET = ESC + "[0m";
    ANSI_BOLD = ESC + "[1m";
    ANSI_DIM = ESC + "[2m";
    ANSI_CYAN = ESC + "[96m";
    ANSI_GREEN = ESC + "[92m";
    ANSI_YELLOW = ESC + "[93m";
    ANSI_GRAY = ESC + "[90m";
    ANSI_WHITE = ESC + "[97m";
}

fn draw_header() {
    sys_fb_draw_rect(0, 0, 1280, 24, CLR_HEADER_BG);
    sys_fb_draw_string(20, 4, "uOS Autonomous Studio (agy)", CLR_TEXT, CLR_HEADER_BG);
    sys_fb_draw_string(1140, 4, "Gemini 3.8", CLR_ACCENT, CLR_HEADER_BG);
    sys_fb_draw_rect(0, 24, 1280, 1, CLR_BORDER);
}

fn draw_panels() {
    sys_fb_draw_rect(860, 25, 1, 775, CLR_BORDER);

    sys_fb_draw_string(20, 32, "CONSOLE", CLR_MUTED, CLR_BG);
    sys_fb_draw_rect(20, 48, 820, 1, CLR_BORDER);

    sys_fb_draw_string(880, 32, "ACTORS & TELEMETRY", CLR_MUTED, CLR_BG);
    sys_fb_draw_rect(880, 48, 380, 1, CLR_BORDER);
}

fn render_chat() {
    // Clear chat viewport (leaves prompt area intact)
    sys_fb_draw_rect(20, 50, 835, 690, CLR_BG);
    
    start_y = 724; // 740 - 16
    idx = len(chat_lines) - 1;
    while (idx >= 0) {
        if (start_y < 50) {
            idx = 0 - 1; // break
        } else {
            sys_fb_draw_string(20, start_y, chat_lines[idx], chat_colors[idx], CLR_BG);
            start_y = start_y - 16;
            idx = idx - 1;
        }
    }
}

fn cmd_clear() {
    chat_lines = [];
    chat_colors = [];
    render_chat();
}

fn console_write(text, color) {
    if (len(cur_line_text) == 0) {
        cur_line_color = color;
    }
    cur_line_text = cur_line_text + text;
    sys_serial_write(text);
}

fn console_newline() {
    chat_lines = push(chat_lines, cur_line_text);
    chat_colors = push(chat_colors, cur_line_color);
    cur_line_text = "";
    render_chat();
    sys_serial_write("\n");
}

fn console_writeln(text, color) {
    console_write(text, color);
    console_newline();
}

fn emit_word_chunks(word, color) {
    w = word;
    while (len(w) * 8 > 800) {
        chunk = substr(w, 0, 100);
        console_write(chunk, color);
        console_newline();
        w = substr(w, 100, len(w));
    }
    return w;
}

fn scan_next_word(text, start_i, tlen) {
    w = "";
    cur_i = start_i;
    scanning = 1;
    while (scanning == 1) {
        if (cur_i >= tlen) {
            scanning = 0;
        } else {
            ch = substr(text, cur_i, cur_i + 1);
            if (ch == " ") { scanning = 0; }
            else if (ch == "\n") { scanning = 0; }
            else if (ch == "\r") { scanning = 0; }
            else {
                w = w + ch;
                cur_i = cur_i + 1;
            }
        }
    }
    return w;
}

fn console_print_wrapped(text, color) {
    tlen = len(text);
    i = 0;
    line = "";
    line_w = 0;
    while (i < tlen) {
        ch = substr(text, i, i + 1);
        if (ch == "\r") {
            i = i + 1;
        } else if (ch == "\n") {
            if (len(line) > 0) { console_write(line, color); }
            console_newline();
            line = "";
            line_w = 0;
            i = i + 1;
        } else if (ch == " ") {
            if (len(line) > 0) {
                line = line + " ";
                line_w = line_w + 8;
            }
            i = i + 1;
        } else {
            word = scan_next_word(text, i, tlen);
            i = i + len(word);
            if (line_w + len(word) * 8 > 800) {
                if (len(line) > 0) { console_write(line, color); console_newline(); }
                line = "";
                line_w = 0;
            }
            word = emit_word_chunks(word, color);
            line = line + word;
            line_w = line_w + len(word) * 8;
        }
    }
    if (len(line) > 0) { console_write(line, color); console_newline(); }
}

fn render_inspector() {
    sys_fb_draw_rect(880, 58, 380, 730, CLR_BG);
    sys_fb_draw_string(880, 60, "Active Actors:  " + int_to_str(sys_actor_count()), CLR_TEXT, CLR_BG);
    
    var_y = 84;
    var_id = 0;
    while (var_id < 8) {
        st = sys_actor_state(var_id);
        if (st >= 0) {
            nm = sys_actor_name(var_id);
            sys_fb_draw_string(880, var_y, "Actor " + int_to_str(var_id) + ":  " + nm, CLR_MUTED, CLR_BG);
            var_y = var_y + 16;
        }
        var_id = var_id + 1;
    }

    var_y = var_y + 16;
    sys_fb_draw_string(880, var_y, "Fault Guard:    " + int_to_str(sys_fault_count()) + " faults", CLR_MUTED, CLR_BG);
    var_y = var_y + 16;
    sys_fb_draw_string(880, var_y, "State:          Online", CLR_GREEN, CLR_BG);
}

fn find_str(haystack, needle) {
    hlen = len(haystack);
    nlen = len(needle);
    if (nlen > hlen) { return 0 - 1; }
    i = 0;
    while (i <= hlen - nlen) {
        if (substr(haystack, i, i + nlen) == needle) {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn extract_code(resp) {
    native_code = sys_ai_extract_code(resp);
    if (len(native_code) > 0) {
        return native_code;
    }
    p1 = find_str(resp, "```");
    if (p1 >= 0) {
        rest = substr(resp, p1 + 3, len(resp));
        nl = find_str(rest, "\n");
        if (nl >= 0) {
            rest = substr(rest, nl + 1, len(rest));
        }
        p2 = find_str(rest, "```");
        if (p2 >= 0) {
            return substr(rest, 0, p2);
        }
        return rest;
    }
    return "";
}

fn is_prefix(str, pre) {
    sl = len(str);
    pl = len(pre);
    if (pl > sl) { return false; }
    return substr(str, 0, pl) == pre;
}

fn cmd_help() {
    console_writeln("-- agy Slash Commands --------------------------", CLR_MUTED);
    console_writeln("  /help         - Show command and tool reference", CLR_TEXT);
    console_writeln("  /status       - System telemetry and agent state", CLR_TEXT);
    console_writeln("  /actors       - List registered actors / subagents", CLR_TEXT);
    console_writeln("  /clear        - Clear the conversation log", CLR_TEXT);
    console_writeln("  /layout <l>   - Set keyboard layout (es or us)", CLR_TEXT);
    console_writeln("  /history      - Display recent prompt history", CLR_TEXT);
    console_writeln("  /reset        - Reset agent conversation context", CLR_TEXT);
    console_writeln("  /model        - Display active LLM model info", CLR_TEXT);
    console_writeln("  /kill <id>    - Terminate actor by ID", CLR_TEXT);
    console_writeln("  /exit         - Return to MicroShell (msh)", CLR_TEXT);
    console_writeln("-- Resident AI Tools (agy Suite) ---------------", CLR_MUTED);
    console_writeln("  run_command(cmd)          - Execute command/code", CLR_TEXT);
    console_writeln("  view_file(path)           - Read file content", CLR_TEXT);
    console_writeln("  write_to_file(path, txt)  - Create/overwrite file", CLR_TEXT);
    console_writeln("  replace_file_content(...) - Edit text in file", CLR_TEXT);
    console_writeln("  list_dir(prefix)          - List catalog files", CLR_TEXT);
    console_writeln("  grep_search(query)        - Search text in files", CLR_TEXT);
    console_writeln("  spawn_actor(name, src)    - Spawn worker actor", CLR_TEXT);
    console_writeln("  query_telemetry()         - Query system metrics", CLR_TEXT);
    console_writeln("-- Conversational Agent ------------------------", CLR_MUTED);
    console_writeln("  <prompt>      - Type any text directly to chat", CLR_TEXT);
}

fn cmd_status() {
    console_writeln("* Agent     : Online (agy mode)", CLR_GREEN);
    console_writeln("* Model     : Gemini 3.8 Flash (Sovereign ABI)", CLR_ACCENT);
    console_writeln("* Actors    : " + int_to_str(sys_actor_count()) + " active", CLR_TEXT);
    console_writeln("* Faults    : " + int_to_str(sys_fault_count()) + " contained", CLR_TEXT);
}

fn cmd_model() {
    console_writeln("Active AI Provider: Gemini (TLS 1.3)", CLR_ACCENT);
    console_writeln("Model Identifier  : gemini-3.8-flash", CLR_TEXT);
    console_writeln("Thinking Level    : Low (zero-alloc streaming)", CLR_MUTED);
    return 0;
}

fn cmd_history() {
    console_writeln("-- Prompt History ------------------------------", CLR_MUTED);
    hlen = len(conv_history);
    if (hlen == 0) {
        console_writeln("  (no user prompts recorded)", CLR_TEXT);
        return 0;
    }
    hi = 0;
    while (hi < hlen) {
        console_writeln("  [" + int_to_str(hi + 1) + "] " + conv_history[hi], CLR_TEXT);
        hi = hi + 1;
    }
    return 0;
}

fn cmd_reset() {
    conv_history = [];
    cmd_clear();
    console_writeln("[agy] Conversation context reset.", CLR_GREEN);
    return 0;
}

fn state_name(st) {
    if (st == 1) { return "ready"; }
    if (st == 2) { return "running"; }
    if (st == 3) { return "paused"; }
    if (st == 4) { return "faulted"; }
    if (st == 5) { return "stopped"; }
    return "inactive";
}

fn pad_right_18(str) {
    pad = 18 - len(str);
    res = str;
    while (pad > 0) {
        res = res + " ";
        pad = pad - 1;
    }
    return res;
}

fn cmd_actors() {
    console_writeln("------------------------------------------------", CLR_BORDER);
    console_writeln(" ID  Name               State", CLR_MUTED);
    console_writeln("------------------------------------------------", CLR_BORDER);
    aid = 0;
    while (aid < 8) {
        ast = sys_actor_state(aid);
        if (ast >= 0) {
            id_s = int_to_str(aid);
            if (len(id_s) == 1) { id_s = " " + id_s; }
            nm = pad_right_18(sys_actor_name(aid));
            console_writeln(" " + id_s + "  " + nm + " " + state_name(ast), CLR_TEXT);
        }
        aid = aid + 1;
    }
    console_writeln("------------------------------------------------", CLR_BORDER);
}

fn cmd_ai(prompt) {
    conv_history = push(conv_history, prompt);
    console_writeln("[agy] Thinking...", CLR_MUTED);
    resp = sys_ai_prompt(prompt);
    if (len(resp) == 0) {
        console_writeln("[agy] Offline or auth failure (check network / API key).", CLR_WARN);
        return 0;
    }
    turn = 0;
    while (turn < 5) {
        tool_res = sys_ai_tool_call(resp);
        if (len(tool_res) == 0) {
            turn = 999;
        } else {
            console_writeln("● " + tool_res, CLR_GREEN);
            render_inspector();
            resp = sys_ai_prompt("Tool result: " + tool_res + ". Continue task or provide final summary.");
            if (len(resp) == 0) {
                console_writeln("[agy] Follow-up turn failed.", CLR_WARN);
                return 0;
            }
            turn = turn + 1;
        }
    }
    console_write("agy> ", CLR_GREEN);
    console_print_wrapped(resp, CLR_TEXT);
    code = extract_code(resp);
    if (len(code) > 0) {
        console_writeln("[agy] Synthesized Actor code detected. Spawning...", CLR_GREEN);
        actor_id = sys_actor_spawn_code("child_worker", code);
        if (actor_id < 0) {
            console_writeln("[kernel] Failed to compile or spawn actor from AI code.", CLR_WARN);
        } else {
            console_writeln("  └─> Spawned dynamic Actor " + int_to_str(actor_id), CLR_GREEN);
            render_inspector();
        }
    }
    return 0;
}

fn cmd_store(code) {
    hash = sys_cas_put(code);
    if (len(hash) == 0) {
        console_writeln("Storage error: Failed to store in CAS.", CLR_WARN);
        return 0;
    }
    console_writeln("Stored in CAS. Hash: " + hash, CLR_GREEN);
    return 0;
}

fn cmd_fetch(hash) {
    content = sys_cas_get(hash);
    if (len(content) == 0) {
        console_writeln("CAS chunk not found: " + hash, CLR_WARN);
    } else {
        console_writeln("--- CAS Payload ---", CLR_MUTED);
        console_writeln(content, CLR_TEXT);
    }
    return 0;
}

fn cmd_persist(target) {
    hash = sys_actor_persist(str_to_int(target));
    if (len(hash) == 0) {
        console_writeln("Storage error: Failed to persist Actor " + target, CLR_WARN);
        return 0;
    }
    console_writeln("Actor " + target + " persisted. Root Hash: " + hash, CLR_GREEN);
    return 0;
}

fn cmd_spawn_cas(hash) {
    actor_id = sys_actor_spawn_cas(hash);
    if (actor_id < 0) {
        console_writeln("Storage error: Failed to spawn from CAS hash: " + hash, CLR_WARN);
        return 0;
    }
    console_writeln("Spawned Actor " + int_to_str(actor_id) + " from CAS", CLR_GREEN);
    render_inspector();
    return 0;
}

fn eval_layout(lang) {
    if (lang == "es") {
        sys_kbd_layout(1);
        console_writeln("Keyboard layout set to ES-LATAM", CLR_GREEN);
    } else if (lang == "us") {
        sys_kbd_layout(0);
        console_writeln("Keyboard layout set to US-QWERTY", CLR_GREEN);
    } else {
        console_writeln("Unknown layout. Use '/layout es' or '/layout us'", CLR_WARN);
    }
    return 0;
}

fn eval_command(cmd) {
    if (cmd == "/help") { return cmd_help(); }
    if (cmd == "help") { return cmd_help(); }
    if (cmd == "/status") { return cmd_status(); }
    if (cmd == "status") { return cmd_status(); }
    if (cmd == "/actors") { return cmd_actors(); }
    if (cmd == "actors") { return cmd_actors(); }
    if (cmd == "/clear") { return cmd_clear(); }
    if (cmd == "clear") { return cmd_clear(); }
    if (cmd == "/history") { return cmd_history(); }
    if (cmd == "history") { return cmd_history(); }
    if (cmd == "/reset") { return cmd_reset(); }
    if (cmd == "reset") { return cmd_reset(); }
    if (cmd == "/model") { return cmd_model(); }
    if (cmd == "model") { return cmd_model(); }
    if (is_prefix(cmd, "store ")) { return cmd_store(substr(cmd, 6, len(cmd))); }
    if (is_prefix(cmd, "fetch ")) { return cmd_fetch(substr(cmd, 6, len(cmd))); }
    if (is_prefix(cmd, "persist ")) { return cmd_persist(substr(cmd, 8, len(cmd))); }
    if (is_prefix(cmd, "spawn_cas ")) { return cmd_spawn_cas(substr(cmd, 10, len(cmd))); }
    if (is_prefix(cmd, "/layout ")) { return eval_layout(substr(cmd, 8, len(cmd))); }
    if (is_prefix(cmd, "layout ")) { return eval_layout(substr(cmd, 7, len(cmd))); }
    if (is_prefix(cmd, "/kill ")) {
        target = substr(cmd, 6, len(cmd));
        sys_actor_terminate(str_to_int(target));
        console_writeln("Terminated Actor " + target, CLR_WARN);
        render_inspector();
        return 0;
    }
    if (is_prefix(cmd, "kill ")) {
        target = substr(cmd, 5, len(cmd));
        sys_actor_terminate(str_to_int(target));
        console_writeln("Terminated Actor " + target, CLR_WARN);
        render_inspector();
        return 0;
    }
    
    // Everything else is a direct chat prompt to the Resident AI Agent
    return cmd_ai(cmd);
}

line_buf = "";
line_pos = 0;
vim_mode = 0; // 0 = insert, 1 = normal

fn render_prompt() {
    sys_fb_draw_rect(20, PROMPT_Y, 835, 16, CLR_BG);
    sys_fb_draw_string(20, PROMPT_Y, "agy> ", CLR_ACCENT, CLR_BG);
    sys_fb_draw_string(68, PROMPT_Y, line_buf, CLR_TEXT, CLR_BG);
    
    cur_px = 68 + line_pos * 8;
    if (vim_mode == 0) {
        sys_fb_draw_rect(cur_px, PROMPT_Y, 2, 16, CLR_GREEN);
    } else {
        sys_fb_draw_rect(cur_px, PROMPT_Y, 8, 16, CLR_MUTED);
        if (line_pos < len(line_buf)) {
            ch = substr(line_buf, line_pos, line_pos + 1);
            sys_fb_draw_string(cur_px, PROMPT_Y, ch, CLR_BG, CLR_MUTED);
        }
    }
    
    esc = char_to_str(27);
    cr = char_to_str(13);
    sys_serial_write(cr + esc + "[K" + ANSI_BOLD + ANSI_CYAN + "agy> " + ANSI_RESET + line_buf);
    back_steps = len(line_buf) - line_pos;
    if (back_steps > 0) {
        sys_serial_write(esc + "[" + int_to_str(back_steps) + "D");
    }
}

fn poll_char() {
    c = sys_serial_read();
    if (c >= 0) { return c; }
    return sys_kbd_read();
}

fn handle_newline() {
    console_writeln("user> " + line_buf, CLR_ACCENT);
    if (len(line_buf) > 0) {
        if (line_buf == "/exit") {
            console_writeln("Halting harness. Returning to msh.", CLR_MUTED);
            return false;
        }
        if (line_buf == "exit") {
            console_writeln("Halting harness. Returning to msh.", CLR_MUTED);
            return false;
        }
        if (line_buf == "/quit") {
            console_writeln("Halting harness. Returning to msh.", CLR_MUTED);
            return false;
        }
        if (line_buf == "quit") {
            console_writeln("Halting harness. Returning to msh.", CLR_MUTED);
            return false;
        }
        eval_command(line_buf);
    }
    line_buf = "";
    line_pos = 0;
    vim_mode = 0;
    return true;
}

fn handle_backspace() {
    if (line_pos > 0) {
        left = substr(line_buf, 0, line_pos - 1);
        right = substr(line_buf, line_pos, len(line_buf));
        line_buf = left + right;
        line_pos = line_pos - 1;
    }
}

fn handle_printable(c) {
    ch_str = char_to_str(c);
    left = substr(line_buf, 0, line_pos);
    right = substr(line_buf, line_pos, len(line_buf));
    line_buf = left + ch_str + right;
    line_pos = line_pos + 1;
}

fn harness_loop() {
    last_char = 0;
    running = true;
    render_prompt();
    while (running) {
        c = poll_char();
        if (c < 0) {
            sys_yield();
        } else if (c == 258) { // LEFT
            if (line_pos > 0) { line_pos = line_pos - 1; render_prompt(); }
        } else if (c == 259) { // RIGHT
            if (line_pos < len(line_buf)) { line_pos = line_pos + 1; render_prompt(); }
        } else if (c == 262) { // HOME
            line_pos = 0; render_prompt();
        } else if (c == 263) { // END
            line_pos = len(line_buf); render_prompt();
        } else if (c == 27) { // ESCAPE
            if (vim_mode == 0) {
                vim_mode = 1;
                if (line_pos > 0) { line_pos = line_pos - 1; }
            }
            render_prompt();
        } else if (c == 10) {
            running = handle_newline();
            if (running) { render_prompt(); }
        } else if (c == 13) {
            running = handle_newline();
            if (running) { render_prompt(); }
        } else if (c == 8) {
            if (vim_mode == 0) { handle_backspace(); }
            render_prompt();
        } else if (c == 127) {
            if (vim_mode == 0) { handle_backspace(); }
            render_prompt();
        } else if (c >= 32) {
            if (c <= 126) {
                if (vim_mode == 1) {
                    if (c == 105) { vim_mode = 0; } // i
                    else if (c == 97) { vim_mode = 0; if (line_pos < len(line_buf)) { line_pos = line_pos + 1; } } // a
                    else if (c == 65) { vim_mode = 0; line_pos = len(line_buf); } // A
                    else if (c == 73) { vim_mode = 0; line_pos = 0; } // I
                    else if (c == 104) { if (line_pos > 0) { line_pos = line_pos - 1; } } // h
                    else if (c == 108) { if (line_pos < len(line_buf)) { line_pos = line_pos + 1; } } // l
                    else if (c == 48) { line_pos = 0; } // 0
                    else if (c == 36) { line_pos = len(line_buf); } // $
                } else {
                    handle_printable(c);
                }
                render_prompt();
            }
        }
    }
}

fn harness_main() {
    init_theme();
    init_ansi();
    sys_fb_clear(CLR_BG);
    draw_header();
    draw_panels();
    render_inspector();
    console_writeln("uOS Autonomous Agent Studio (agy)", CLR_ACCENT);
    console_writeln("Resident AI: Gemini 3.8 Flash | Protocol: Sovereign ABI", CLR_MUTED);
    console_writeln("Type /help for commands. Unprefixed text is sent to AI Agent.", CLR_MUTED);
    console_writeln("------------------------------------------------", CLR_BORDER);
    harness_loop();
    sys_fb_clear(CLR_BG);
    return 0;
}

harness_main();
