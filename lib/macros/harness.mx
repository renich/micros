// MicrOS (µOS) Interactive Autonomous Agent Studio (harness)
// Standalone conversational interface running inside Actor 0.
// Modelled after high-capability agent studios with multi-conversations,
// context auto-compression, clipboard copy/paste, search, readline & vim modes.

fn init_theme() {
    CLR_BG = 0;             // Pure pitch black: 0x000000
    CLR_HEADER_BG = 856343; // Dark charcoal header: 0x0D1117
    CLR_BORDER = 2238254;   // Hairline graphite border: 0x22272E
    CLR_TEXT = 15132390;    // Crisp neutral white: 0xE6EDF3
    CLR_MUTED = 8226192;    // Refined slate gray: 0x7D8590
    CLR_ACCENT = 5809919;   // Ice sapphire blue: 0x58A6FF
    CLR_GREEN = 4176208;    // Emerald green: 0x3FB950
    CLR_WARN = 13801762;    // Amber: 0xD29922
    
    // Chat History & Multi-Conversation State
    chat_lines = [];
    chat_colors = [];
    cur_line_text = "";
    cur_line_color = CLR_TEXT;
    conv_history = [];
    
    conversations = ["General"];
    conv_active_idx = 0;
    conv_stores = push([], []);
    conv_color_stores = push([], []);
    conv_prompt_stores = push([], []);
    clipboard_buf = "";
    last_resp_text = "";
    last_resp_code = "";
    compressed_summary = "";
    prompt_history = [];
    hist_pos = 0 - 1;
    saved_draft = "";
    line_buf = "";
    line_pos = 0;
    vim_mode = 0;
    PROMPT_Y = 750;
}

fn init_ansi() {
    ESC = char_to_str(27);
    ANSI_RESET = ESC + "[0m";
    ANSI_BOLD = ESC + "[1m";
    ANSI_CYAN = ESC + "[96m";
}

fn draw_header() {
    sys_fb_draw_rect(0, 0, 1280, 24, CLR_HEADER_BG);
    sys_fb_draw_string(20, 4, "uOS Autonomous Studio (harness)", CLR_TEXT, CLR_HEADER_BG);
    conv_title = conversations[conv_active_idx];
    if (len(conv_title) > 20) { conv_title = substr(conv_title, 0, 17) + "..."; }
    sys_fb_draw_string(450, 4, "[" + conv_title + "]", CLR_MUTED, CLR_HEADER_BG);
    sys_fb_draw_string(1140, 4, "Gemini 3.8", CLR_ACCENT, CLR_HEADER_BG);
    sys_fb_draw_rect(0, 24, 1280, 1, CLR_BORDER);
}

fn draw_panels() {
    sys_fb_draw_rect(860, 25, 1, 775, CLR_BORDER);
    sys_fb_draw_string(20, 32, "CONSOLE", CLR_MUTED, CLR_BG);
    sys_fb_draw_rect(20, 48, 820, 1, CLR_BORDER);
    sys_fb_draw_string(880, 32, "ACTORS & TELEMETRY", CLR_MUTED, CLR_BG);
    sys_fb_draw_rect(880, 48, 380, 1, CLR_BORDER);
}

fn render_chat() {
    sys_fb_draw_rect(20, 50, 835, 690, CLR_BG);
    start_y = 724;
    idx = len(chat_lines) - 1;
    while (idx >= 0) {
        if (start_y < 50) {
            idx = 0 - 1;
        } else {
            line_txt = chat_lines[idx];
            if (len(line_txt) > 102) { line_txt = substr(line_txt, 0, 102); }
            sys_fb_draw_string(20, start_y, line_txt, chat_colors[idx], CLR_BG);
            start_y = start_y - 16;
            idx = idx - 1;
        }
    }
}

fn cmd_clear() {
    chat_lines = [];
    chat_colors = [];
    render_chat();
}

fn console_write(text, color) {
    if (len(cur_line_text) == 0) {
        cur_line_color = color;
    }
    cur_line_text = cur_line_text + text;
    sys_serial_write(text);
}

fn console_newline() {
    chat_lines = push(chat_lines, cur_line_text);
    chat_colors = push(chat_colors, cur_line_color);
    cur_line_text = "";
    render_chat();
    sys_serial_write("\r\n");
}

fn console_writeln(text, color) {
    console_write(text, color);
    console_newline();
}

fn emit_word_chunks(word, color) {
    w = word;
    while (len(w) * 8 > 800) {
        chunk = substr(w, 0, 100);
        console_write(chunk, color);
        console_newline();
        w = substr(w, 100, len(w));
    }
    return w;
}

fn scan_next_word(text, start_i, tlen) {
    w = "";
    cur_i = start_i;
    scanning = 1;
    while (scanning == 1) {
        if (cur_i >= tlen) {
            scanning = 0;
        } else {
            ch = substr(text, cur_i, cur_i + 1);
            if (ch == " ") { scanning = 0; }
            else if (ch == "\n") { scanning = 0; }
            else if (ch == "\r") { scanning = 0; }
            else {
                w = w + ch;
                cur_i = cur_i + 1;
            }
        }
    }
    return w;
}

fn console_print_wrapped(text, color) {
    tlen = len(text);
    i = 0;
    line = "";
    line_w = 0;
    while (i < tlen) {
        ch = substr(text, i, i + 1);
        if (ch == "\r") {
            i = i + 1;
        } else if (ch == "\n") {
            if (len(line) > 0) { console_write(line, color); }
            console_newline();
            line = "";
            line_w = 0;
            i = i + 1;
        } else if (ch == " ") {
            if (len(line) > 0) {
                line = line + " ";
                line_w = line_w + 8;
            }
            i = i + 1;
        } else {
            word = scan_next_word(text, i, tlen);
            i = i + len(word);
            if (line_w + len(word) * 8 > 800) {
                if (len(line) > 0) { console_write(line, color); console_newline(); }
                line = "";
                line_w = 0;
            }
            word = emit_word_chunks(word, color);
            line = line + word;
            line_w = line_w + len(word) * 8;
        }
    }
    if (len(line) > 0) { console_write(line, color); console_newline(); }
}

fn render_inspector() {
    sys_fb_draw_rect(861, 25, 419, 775, CLR_BG);
    sys_fb_draw_rect(860, 25, 1, 775, CLR_BORDER);
    sys_fb_draw_string(880, 32, "ACTORS & TELEMETRY", CLR_MUTED, CLR_BG);
    sys_fb_draw_rect(880, 48, 380, 1, CLR_BORDER);
    sys_fb_draw_string(880, 60, "Active Actors:  " + int_to_str(sys_actor_count()), CLR_TEXT, CLR_BG);
    
    var_y = 84;
    var_id = 0;
    while (var_id < 8) {
        st = sys_actor_state(var_id);
        if (st >= 0) {
            nm = sys_actor_name(var_id);
            sys_fb_draw_string(880, var_y, "Actor " + int_to_str(var_id) + ":  " + nm, CLR_MUTED, CLR_BG);
            var_y = var_y + 16;
        }
        var_id = var_id + 1;
    }

    var_y = var_y + 16;
    sys_fb_draw_string(880, var_y, "Fault Guard:    " + int_to_str(sys_fault_count()) + " faults", CLR_MUTED, CLR_BG);
    var_y = var_y + 16;
    sys_fb_draw_string(880, var_y, "State:          Online", CLR_GREEN, CLR_BG);
    var_y = var_y + 16;
    clip_len = len(clipboard_buf);
    sys_fb_draw_string(880, var_y, "Clipboard:      " + int_to_str(clip_len) + " chars", CLR_ACCENT, CLR_BG);
}

fn find_str(haystack, needle) {
    hlen = len(haystack);
    nlen = len(needle);
    if (nlen > hlen) { return 0 - 1; }
    i = 0;
    while (i <= hlen - nlen) {
        if (substr(haystack, i, i + nlen) == needle) {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn extract_code(resp) {
    native_code = sys_ai_extract_code(resp);
    if (len(native_code) > 0) {
        return native_code;
    }
    p1 = find_str(resp, "```");
    if (p1 >= 0) {
        rest = substr(resp, p1 + 3, len(resp));
        nl = find_str(rest, "\n");
        if (nl >= 0) {
            rest = substr(rest, nl + 1, len(rest));
        }
        p2 = find_str(rest, "```");
        if (p2 >= 0) {
            return substr(rest, 0, p2);
        }
        return rest;
    }
    return "";
}

fn is_prefix(str, pre) {
    sl = len(str);
    pl = len(pre);
    if (pl > sl) { return false; }
    return substr(str, 0, pl) == pre;
}

fn hist_prev() {
    hlen = len(prompt_history);
    if (hlen == 0) { return 0; }
    if (hist_pos == 0 - 1) {
        saved_draft = line_buf;
        hist_pos = hlen;
    }
    if (hist_pos > 0) {
        hist_pos = hist_pos - 1;
        line_buf = prompt_history[hist_pos];
        line_pos = len(line_buf);
    }
    return 0;
}

fn hist_next() {
    hlen = len(prompt_history);
    if (hist_pos >= 0) {
        hist_pos = hist_pos + 1;
        if (hist_pos >= hlen) {
            hist_pos = 0 - 1;
            line_buf = saved_draft;
            line_pos = len(line_buf);
        } else {
            line_buf = prompt_history[hist_pos];
            line_pos = len(line_buf);
        }
    }
    return 0;
}

fn jump_word_forward() {
    blen = len(line_buf);
    p = line_pos;
    while (p < blen) {
        if (substr(line_buf, p, p + 1) == " ") { break; }
        p = p + 1;
    }
    while (p < blen) {
        if (substr(line_buf, p, p + 1) != " ") { break; }
        p = p + 1;
    }
    line_pos = p;
}

fn jump_word_backward() {
    p = line_pos;
    if (p > 0) { p = p - 1; }
    while (p > 0) {
        if (substr(line_buf, p, p + 1) != " ") { break; }
        p = p - 1;
    }
    while (p > 0) {
        if (substr(line_buf, p - 1, p) == " ") { break; }
        p = p - 1;
    }
    line_pos = p;
}

fn delete_char_at_cursor() {
    blen = len(line_buf);
    if (line_pos < blen) {
        line_buf = substr(line_buf, 0, line_pos) + substr(line_buf, line_pos + 1, blen);
    }
}

fn delete_word_backward() {
    old_p = line_pos;
    jump_word_backward();
    line_buf = substr(line_buf, 0, line_pos) + substr(line_buf, old_p, len(line_buf));
}

