// MicrOS (µOS) Sovereign Actor Harness & Construction Environment
// Executed natively inside Actor 0 under capability control.
// Provides live status, vector canvas rendering, actor inspection, and command loop.

fn init_ansi() {
    ESC = char_to_str(27);
    ANSI_RESET = ESC + "[0m";
    ANSI_BOLD = ESC + "[1m";
    ANSI_DIM = ESC + "[2m";
    ANSI_CYAN = ESC + "[96m";
    ANSI_GREEN = ESC + "[92m";
    ANSI_YELLOW = ESC + "[93m";
    ANSI_GRAY = ESC + "[90m";
    ANSI_WHITE = ESC + "[97m";
}

fn draw_header() {
    sys_fb_draw_rect(0, 0, 1280, 48, 100000);
    sys_fb_draw_string(20, 12, "MicrOS (uOS) Sovereign Harness v1.0", 57599, 100000);
    sys_fb_draw_string(450, 12, "Zero PIDs | Zero Libc | Actor Substrate Active", 5306999, 100000);
    sys_fb_draw_rect(0, 46, 1280, 2, 57599);
}

fn draw_panels() {
    sys_fb_draw_rect(20, 60, 800, 680, 65822);
    sys_fb_draw_rect(20, 60, 800, 28, 131614);
    sys_fb_draw_string(30, 68, "Console & Evaluator", 16777215, 131614);

    sys_fb_draw_rect(840, 60, 420, 680, 65822);
    sys_fb_draw_rect(840, 60, 420, 28, 131614);
    sys_fb_draw_string(850, 68, "Actor & Capability Inspector", 16777215, 131614);
}

cur_x = 30;
cur_y = 100;

fn cmd_clear() {
    sys_fb_draw_rect(22, 90, 796, 646, 65822);
    cur_x = 30;
    cur_y = 100;
}

fn console_write(text, color) {
    sys_fb_draw_string(cur_x, cur_y, text, color, 65822);
    cur_x = cur_x + len(text) * 8;
    sys_serial_write(text);
}

fn console_newline() {
    cur_x = 30;
    cur_y = cur_y + 16;
    sys_serial_write("\n");
    if (cur_y > 680) {
        cmd_clear();
    }
}

fn console_writeln(text, color) {
    console_write(text, color);
    console_newline();
}

fn render_inspector() {
    sys_fb_draw_rect(842, 90, 416, 646, 65822);
    sys_fb_draw_string(850, 100, "Active Actors: " + int_to_str(sys_actor_count()), 57599, 65822);
    
    var_y = 124;
    var_id = 0;
    while (var_id < 8) {
        st = sys_actor_state(var_id);
        if (st >= 0) {
            nm = sys_actor_name(var_id);
            sys_fb_draw_string(850, var_y, "Actor " + int_to_str(var_id) + ": " + nm, 16777215, 65822);
            var_y = var_y + 16;
        }
        var_id = var_id + 1;
    }

    var_y = var_y + 16;
    sys_fb_draw_string(850, var_y, "Total Faults: " + int_to_str(sys_fault_count()), 5306999, 65822);
    var_y = var_y + 16;
    sys_fb_draw_string(850, var_y, "Health: Sovereign", 5306999, 65822);
}

fn find_str(haystack, needle) {
    hlen = len(haystack);
    nlen = len(needle);
    if (nlen > hlen) { return 0 - 1; }
    i = 0;
    while (i <= hlen - nlen) {
        if (substr(haystack, i, i + nlen) == needle) {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn extract_code(resp) {
    p1 = find_str(resp, "```");
    if (p1 >= 0) {
        rest = substr(resp, p1 + 3, len(resp));
        nl = find_str(rest, "\n");
        if (nl >= 0) {
            rest = substr(rest, nl + 1, len(rest));
        }
        p2 = find_str(rest, "```");
        if (p2 >= 0) {
            return substr(rest, 0, p2);
        }
        return rest;
    }
    p_rst = find_str(resp, ".. code-block::");
    dir_len = 15;
    if (p_rst < 0) {
        p_rst = find_str(resp, ".. code::");
        dir_len = 9;
    }
    if (p_rst >= 0) {
        rest_rst = substr(resp, p_rst + dir_len, len(resp));
        nl_rst = find_str(rest_rst, "\n");
        if (nl_rst >= 0) {
            return substr(rest_rst, nl_rst + 1, len(rest_rst));
        }
        return rest_rst;
    }
    return "";
}

fn is_prefix(str, pre) {
    sl = len(str);
    pl = len(pre);
    if (pl > sl) { return false; }
    return substr(str, 0, pl) == pre;
}

fn cmd_help() {
    console_writeln("-- System Commands -----------------------------", 57599);
    console_writeln("  help          - Show this command reference", 16777215);
    console_writeln("  status        - Substrate health and telemetry", 16777215);
    console_writeln("  actors        - List registered actors and state", 16777215);
    console_writeln("  clear         - Clear the console viewport", 16777215);
    console_writeln("  kill <id>     - Terminate actor by ID", 16777215);
    console_writeln("  exit          - Halt sovereign harness", 16777215);
    console_writeln("-- Cognitive & Synthesis -----------------------", 57599);
    console_writeln("  ai <prompt>   - Dispatch natural language task to AI", 16777215);
    console_writeln("-- Sovereign Persistence (CAS) -----------------", 57599);
    console_writeln("  store <code>  - Store raw code or text into CAS", 16777215);
    console_writeln("  fetch <hash>  - Retrieve payload from CAS by hash", 16777215);
    console_writeln("  persist <id>  - Persist actor source to CAS root", 16777215);
    console_writeln("  spawn_cas <h> - Restore & spawn actor from CAS hash", 16777215);
}

fn cmd_status() {
    console_writeln("* Substrate : Sovereign (Zero Defects)", 5306999);
    console_writeln("* Actors    : " + int_to_str(sys_actor_count()) + " active", 5306999);
    console_writeln("* Faults    : " + int_to_str(sys_fault_count()) + " contained", 5306999);
}

fn state_name(st) {
    if (st == 1) { return "ready"; }
    if (st == 2) { return "running"; }
    if (st == 3) { return "paused"; }
    if (st == 4) { return "faulted"; }
    if (st == 5) { return "stopped"; }
    return "inactive";
}

fn pad_right_18(str) {
    pad = 18 - len(str);
    res = str;
    while (pad > 0) {
        res = res + " ";
        pad = pad - 1;
    }
    return res;
}

fn cmd_actors() {
    console_writeln("------------------------------------------------", 57599);
    console_writeln(" ID  Name               State", 57599);
    console_writeln("------------------------------------------------", 57599);
    aid = 0;
    while (aid < 8) {
        ast = sys_actor_state(aid);
        if (ast >= 0) {
            id_s = int_to_str(aid);
            if (len(id_s) == 1) { id_s = " " + id_s; }
            nm = pad_right_18(sys_actor_name(aid));
            console_writeln(" " + id_s + "  " + nm + " " + state_name(ast), 16777215);
        }
        aid = aid + 1;
    }
    console_writeln("------------------------------------------------", 57599);
}

fn cmd_ai(prompt) {
    console_writeln("[ai] Querying Resident AI...", 57599);
    resp = sys_ai_prompt(prompt);
    if (len(resp) == 0) {
        console_writeln("[ai] No response or connection timeout.", 16777215);
        return 0;
    }
    console_writeln("*** AI COGNITIVE STREAM ***", 57599);
    console_writeln(resp, 57599);
    code = extract_code(resp);
    if (len(code) > 0) {
        console_writeln("[ai] Executable code block detected. Spawning...", 5306999);
        actor_id = sys_actor_spawn_code("child_worker", code);
        console_writeln("[kernel] Spawned dynamic Actor " + int_to_str(actor_id), 5306999);
        render_inspector();
    }
    return 0;
}

fn cmd_store(code) {
    hash = sys_cas_put(code);
    if (len(hash) == 0) {
        console_writeln("Storage error: Failed to store in CAS.", 16777215);
        return 0;
    }
    console_writeln("Stored in CAS. Hash: " + hash, 5306999);
    return 0;
}

fn cmd_fetch(hash) {
    content = sys_cas_get(hash);
    if (len(content) == 0) {
        console_writeln("CAS chunk not found: " + hash, 16777215);
    } else {
        console_writeln("--- CAS Payload ---", 57599);
        console_writeln(content, 16777215);
    }
    return 0;
}

fn cmd_persist(target) {
    hash = sys_actor_persist(str_to_int(target));
    if (len(hash) == 0) {
        console_writeln("Storage error: Failed to persist Actor " + target, 16777215);
        return 0;
    }
    console_writeln("Actor " + target + " persisted. Root Hash: " + hash, 5306999);
    return 0;
}

fn cmd_spawn_cas(hash) {
    actor_id = sys_actor_spawn_cas(hash);
    if (actor_id < 0) {
        console_writeln("Storage error: Failed to spawn from CAS hash: " + hash, 16777215);
        return 0;
    }
    console_writeln("Spawned Actor " + int_to_str(actor_id) + " from CAS", 5306999);
    render_inspector();
    return 0;
}

fn eval_command(cmd) {
    if (cmd == "help") { return cmd_help(); }
    if (cmd == "status") { return cmd_status(); }
    if (cmd == "actors") { return cmd_actors(); }
    if (cmd == "clear") { return cmd_clear(); }
    if (is_prefix(cmd, "ai ")) { return cmd_ai(substr(cmd, 3, len(cmd))); }
    if (is_prefix(cmd, "store ")) { return cmd_store(substr(cmd, 6, len(cmd))); }
    if (is_prefix(cmd, "fetch ")) { return cmd_fetch(substr(cmd, 6, len(cmd))); }
    if (is_prefix(cmd, "persist ")) { return cmd_persist(substr(cmd, 8, len(cmd))); }
    if (is_prefix(cmd, "spawn_cas ")) { return cmd_spawn_cas(substr(cmd, 10, len(cmd))); }
    if (is_prefix(cmd, "kill ")) {
        target = substr(cmd, 5, len(cmd));
        sys_actor_terminate(str_to_int(target));
        console_writeln("Terminated Actor " + target, 57599);
        render_inspector();
        return 0;
    }
    console_writeln("Unknown command: " + cmd + " (type 'help')", 16777215);
    return 0;
}

fn draw_prompt() {
    sys_fb_draw_string(cur_x, cur_y, "macros> ", 57599, 65822);
    cur_x = cur_x + 64;
    sys_serial_write(ANSI_BOLD + ANSI_CYAN + "µOS " + ANSI_GREEN + "macros>" + ANSI_RESET + " ");
}

fn poll_char() {
    c = sys_serial_read();
    if (c >= 0) { return c; }
    return sys_kbd_read();
}

fn handle_newline(buf) {
    console_newline();
    if (len(buf) > 0) {
        if (buf == "exit") {
            console_writeln("Halting Sovereign Harness.", 57599);
            return false;
        }
        if (buf == "quit") {
            console_writeln("Halting Sovereign Harness.", 57599);
            return false;
        }
        eval_command(buf);
    }
    return true;
}

fn handle_backspace(buf) {
    if (len(buf) > 0) {
        cur_x = cur_x - 8;
        sys_fb_draw_rect(cur_x, cur_y, 8, 16, 65822);
        sys_serial_write(char_to_str(8) + " " + char_to_str(8));
        return substr(buf, 0, len(buf) - 1);
    }
    return buf;
}

fn handle_printable(buf, c) {
    ch_str = char_to_str(c);
    sys_fb_draw_string(cur_x, cur_y, ch_str, 16777215, 65822);
    cur_x = cur_x + 8;
    sys_serial_write(ch_str);
    return buf + ch_str;
}

fn harness_loop() {
    line_buf = "";
    running = true;
    draw_prompt();
    while (running) {
        c = poll_char();
        if (c < 0) {
            sys_yield();
        } else if (c == 13) {
            running = handle_newline(line_buf);
            line_buf = "";
            if (running) { draw_prompt(); }
        } else if (c == 10) {
            running = handle_newline(line_buf);
            line_buf = "";
            if (running) { draw_prompt(); }
        } else if (c == 8) {
            line_buf = handle_backspace(line_buf);
        } else if (c == 127) {
            line_buf = handle_backspace(line_buf);
        } else if (c >= 32) {
            if (c <= 126) {
                line_buf = handle_printable(line_buf, c);
            }
            0;
        }
    }
}

fn harness_main() {
    init_ansi();
    draw_header();
    draw_panels();
    render_inspector();
    sys_serial_write("\n" + ANSI_GRAY + "-- " + ANSI_BOLD + ANSI_CYAN + "Sovereign Actor Harness" + ANSI_RESET + " " + ANSI_GRAY + "-----------------------------------" + ANSI_RESET + "\n");
    sys_serial_write("[harness] Visual canvas and vector status rendered successfully.\n");
    sys_serial_write("[harness] MicrOS (uOS) Sovereign Genesis Actor Online\n");
    sys_serial_write(ANSI_GRAY + "  Type '" + ANSI_WHITE + "help" + ANSI_GRAY + "' for commands or '" + ANSI_WHITE + "ai <prompt>" + ANSI_GRAY + "' to synthesize actors." + ANSI_RESET + "\n\n");
    console_writeln("[SOVEREIGN HARNESS ACTIVE]", 5306999);
    console_writeln("Interactive construction environment online.", 16777215);
    console_writeln("Hardware input: PS/2 Keyboard and COM1 Serial.", 16777215);
    console_writeln("Type 'help' for command reference, or 'ai <prompt>' to create.", 16777215);
    harness_loop();
}

harness_main();
