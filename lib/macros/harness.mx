// MicrOS (µOS) Sovereign Actor Harness & Construction Environment
// Executed natively inside Actor 0 under capability control.
// Provides live status, vector canvas rendering, actor inspection, and command loop.

fn init_theme() {
    CLR_BG = 0;             // Pure pitch black: 0x000000
    CLR_HEADER_BG = 856343; // Dark charcoal header: 0x0D1117
    CLR_BORDER = 2238254;   // Hairline graphite border: 0x22272E
    CLR_TEXT = 15132390;    // Crisp neutral white: 0xE6EDF3
    CLR_MUTED = 8226192;    // Refined slate gray: 0x7D8590
    CLR_ACCENT = 5809919;   // Ice sapphire blue: 0x58A6FF
    CLR_GREEN = 4176208;    // Emerald green: 0x3FB950
    CLR_WARN = 13801762;    // Amber: 0xD29922
    cur_x = 20;
    cur_y = 58;
}

fn init_ansi() {
    ESC = char_to_str(27);
    ANSI_RESET = ESC + "[0m";
    ANSI_BOLD = ESC + "[1m";
    ANSI_DIM = ESC + "[2m";
    ANSI_CYAN = ESC + "[96m";
    ANSI_GREEN = ESC + "[92m";
    ANSI_YELLOW = ESC + "[93m";
    ANSI_GRAY = ESC + "[90m";
    ANSI_WHITE = ESC + "[97m";
}

fn draw_header() {
    sys_fb_draw_rect(0, 0, 1280, 26, CLR_HEADER_BG);
    sys_fb_draw_string(20, 9, "uOS (MicrOS) Sovereign Substrate  [Milestone 14]", CLR_TEXT, CLR_HEADER_BG);
    sys_fb_draw_string(920, 9, "Zero Libc . Capability Security", CLR_MUTED, CLR_HEADER_BG);
    sys_fb_draw_rect(0, 25, 1280, 1, CLR_BORDER);
}

fn draw_panels() {
    sys_fb_draw_rect(860, 26, 1, 774, CLR_BORDER);

    sys_fb_draw_string(20, 36, "CONSOLE", CLR_MUTED, CLR_BG);
    sys_fb_draw_rect(20, 48, 820, 1, CLR_BORDER);

    sys_fb_draw_string(880, 36, "ACTORS & TELEMETRY", CLR_MUTED, CLR_BG);
    sys_fb_draw_rect(880, 48, 380, 1, CLR_BORDER);
}

fn cmd_clear() {
    sys_fb_draw_rect(20, 58, 830, 730, CLR_BG);
    cur_x = 20;
    cur_y = 58;
}

fn console_write(text, color) {
    sys_fb_draw_string(cur_x, cur_y, text, color, CLR_BG);
    cur_x = cur_x + len(text) * 8;
    sys_serial_write(text);
}

fn console_newline() {
    cur_x = 20;
    cur_y = cur_y + 16;
    sys_serial_write("\n");
    if (cur_y > 750) {
        cmd_clear();
    }
}

fn console_writeln(text, color) {
    console_write(text, color);
    console_newline();
}

fn render_inspector() {
    sys_fb_draw_rect(880, 58, 380, 730, CLR_BG);
    sys_fb_draw_string(880, 60, "Active Actors:  " + int_to_str(sys_actor_count()), CLR_TEXT, CLR_BG);
    
    var_y = 84;
    var_id = 0;
    while (var_id < 8) {
        st = sys_actor_state(var_id);
        if (st >= 0) {
            nm = sys_actor_name(var_id);
            sys_fb_draw_string(880, var_y, "Actor " + int_to_str(var_id) + ":  " + nm, CLR_MUTED, CLR_BG);
            var_y = var_y + 16;
        }
        var_id = var_id + 1;
    }

    var_y = var_y + 16;
    sys_fb_draw_string(880, var_y, "Fault Guard:    " + int_to_str(sys_fault_count()) + " faults", CLR_MUTED, CLR_BG);
    var_y = var_y + 16;
    sys_fb_draw_string(880, var_y, "Substrate:      Sovereign Active", CLR_GREEN, CLR_BG);
}

fn find_str(haystack, needle) {
    hlen = len(haystack);
    nlen = len(needle);
    if (nlen > hlen) { return 0 - 1; }
    i = 0;
    while (i <= hlen - nlen) {
        if (substr(haystack, i, i + nlen) == needle) {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn extract_code(resp) {
    native_code = sys_ai_extract_code(resp);
    if (len(native_code) > 0) {
        return native_code;
    }
    p1 = find_str(resp, "```");
    if (p1 >= 0) {
        rest = substr(resp, p1 + 3, len(resp));
        nl = find_str(rest, "\n");
        if (nl >= 0) {
            rest = substr(rest, nl + 1, len(rest));
        }
        p2 = find_str(rest, "```");
        if (p2 >= 0) {
            return substr(rest, 0, p2);
        }
        return rest;
    }
    return "";
}

fn is_prefix(str, pre) {
    sl = len(str);
    pl = len(pre);
    if (pl > sl) { return false; }
    return substr(str, 0, pl) == pre;
}

fn cmd_help() {
    console_writeln("-- System Commands -----------------------------", CLR_MUTED);
    console_writeln("  help          - Show this command reference", CLR_TEXT);
    console_writeln("  status        - Substrate health and telemetry", CLR_TEXT);
    console_writeln("  actors        - List registered actors and state", CLR_TEXT);
    console_writeln("  clear         - Clear the console viewport", CLR_TEXT);
    console_writeln("  kill <id>     - Terminate actor by ID", CLR_TEXT);
    console_writeln("  exit          - Halt sovereign harness", CLR_TEXT);
    console_writeln("-- Cognitive & Synthesis -----------------------", CLR_MUTED);
    console_writeln("  ai <prompt>   - Dispatch natural language task to AI", CLR_TEXT);
    console_writeln("-- Sovereign Persistence (CAS) -----------------", CLR_MUTED);
    console_writeln("  store <code>  - Store raw code or text into CAS", CLR_TEXT);
    console_writeln("  fetch <hash>  - Retrieve payload from CAS by hash", CLR_TEXT);
    console_writeln("  persist <id>  - Persist actor source to CAS root", CLR_TEXT);
    console_writeln("  spawn_cas <h> - Restore & spawn actor from CAS hash", CLR_TEXT);
}

fn cmd_status() {
    console_writeln("* Substrate : Sovereign (Zero Defects)", CLR_GREEN);
    console_writeln("* Actors    : " + int_to_str(sys_actor_count()) + " active", CLR_TEXT);
    console_writeln("* Faults    : " + int_to_str(sys_fault_count()) + " contained", CLR_TEXT);
}

fn state_name(st) {
    if (st == 1) { return "ready"; }
    if (st == 2) { return "running"; }
    if (st == 3) { return "paused"; }
    if (st == 4) { return "faulted"; }
    if (st == 5) { return "stopped"; }
    return "inactive";
}

fn pad_right_18(str) {
    pad = 18 - len(str);
    res = str;
    while (pad > 0) {
        res = res + " ";
        pad = pad - 1;
    }
    return res;
}

fn cmd_actors() {
    console_writeln("------------------------------------------------", CLR_BORDER);
    console_writeln(" ID  Name               State", CLR_MUTED);
    console_writeln("------------------------------------------------", CLR_BORDER);
    aid = 0;
    while (aid < 8) {
        ast = sys_actor_state(aid);
        if (ast >= 0) {
            id_s = int_to_str(aid);
            if (len(id_s) == 1) { id_s = " " + id_s; }
            nm = pad_right_18(sys_actor_name(aid));
            console_writeln(" " + id_s + "  " + nm + " " + state_name(ast), CLR_TEXT);
        }
        aid = aid + 1;
    }
    console_writeln("------------------------------------------------", CLR_BORDER);
}

fn cmd_ai(prompt) {
    console_writeln("[ai] Querying Resident AI...", CLR_ACCENT);
    resp = sys_ai_prompt(prompt);
    if (len(resp) == 0) {
        console_writeln("[ai] No response or auth failure (check API key / AI_PROVIDER).", CLR_WARN);
        return 0;
    }
    console_writeln(resp, CLR_TEXT);
    code = extract_code(resp);
    if (len(code) > 0) {
        console_writeln("[ai] Synthesized Actor code detected. Spawning...", CLR_GREEN);
        actor_id = sys_actor_spawn_code("child_worker", code);
        if (actor_id < 0) {
            console_writeln("[kernel] Failed to compile or spawn actor from AI code.", CLR_WARN);
        } else {
            console_writeln("[kernel] Spawned dynamic Actor " + int_to_str(actor_id), CLR_GREEN);
            render_inspector();
        }
    } else {
        console_writeln("[ai] No executable code block found in AI response.", CLR_WARN);
    }
    return 0;
}

fn cmd_store(code) {
    hash = sys_cas_put(code);
    if (len(hash) == 0) {
        console_writeln("Storage error: Failed to store in CAS.", CLR_WARN);
        return 0;
    }
    console_writeln("Stored in CAS. Hash: " + hash, CLR_GREEN);
    return 0;
}

fn cmd_fetch(hash) {
    content = sys_cas_get(hash);
    if (len(content) == 0) {
        console_writeln("CAS chunk not found: " + hash, CLR_WARN);
    } else {
        console_writeln("--- CAS Payload ---", CLR_MUTED);
        console_writeln(content, CLR_TEXT);
    }
    return 0;
}

fn cmd_persist(target) {
    hash = sys_actor_persist(str_to_int(target));
    if (len(hash) == 0) {
        console_writeln("Storage error: Failed to persist Actor " + target, CLR_WARN);
        return 0;
    }
    console_writeln("Actor " + target + " persisted. Root Hash: " + hash, CLR_GREEN);
    return 0;
}

fn cmd_spawn_cas(hash) {
    actor_id = sys_actor_spawn_cas(hash);
    if (actor_id < 0) {
        console_writeln("Storage error: Failed to spawn from CAS hash: " + hash, CLR_WARN);
        return 0;
    }
    console_writeln("Spawned Actor " + int_to_str(actor_id) + " from CAS", CLR_GREEN);
    render_inspector();
    return 0;
}

fn eval_command(cmd) {
    if (cmd == "help") { return cmd_help(); }
    if (cmd == "status") { return cmd_status(); }
    if (cmd == "actors") { return cmd_actors(); }
    if (cmd == "clear") { return cmd_clear(); }
    if (is_prefix(cmd, "ai ")) { return cmd_ai(substr(cmd, 3, len(cmd))); }
    if (is_prefix(cmd, "store ")) { return cmd_store(substr(cmd, 6, len(cmd))); }
    if (is_prefix(cmd, "fetch ")) { return cmd_fetch(substr(cmd, 6, len(cmd))); }
    if (is_prefix(cmd, "persist ")) { return cmd_persist(substr(cmd, 8, len(cmd))); }
    if (is_prefix(cmd, "spawn_cas ")) { return cmd_spawn_cas(substr(cmd, 10, len(cmd))); }
    if (is_prefix(cmd, "kill ")) {
        target = substr(cmd, 5, len(cmd));
        sys_actor_terminate(str_to_int(target));
        console_writeln("Terminated Actor " + target, CLR_WARN);
        render_inspector();
        return 0;
    }
    console_writeln("Unknown command: " + cmd + " (type 'help')", CLR_WARN);
    return 0;
}

fn draw_prompt() {
    sys_fb_draw_string(cur_x, cur_y, "uOS macros> ", CLR_ACCENT, CLR_BG);
    cur_x = cur_x + 96;
    sys_serial_write(ANSI_BOLD + ANSI_CYAN + "µOS macros>" + ANSI_RESET + " ");
}

fn poll_char() {
    c = sys_serial_read();
    if (c >= 0) { return c; }
    return sys_kbd_read();
}

fn handle_newline(buf) {
    console_newline();
    if (len(buf) > 0) {
        if (buf == "exit") {
            console_writeln("Halting Sovereign Harness.", CLR_MUTED);
            return false;
        }
        if (buf == "quit") {
            console_writeln("Halting Sovereign Harness.", CLR_MUTED);
            return false;
        }
        eval_command(buf);
    }
    return true;
}

fn handle_backspace(buf) {
    if (len(buf) > 0) {
        cur_x = cur_x - 8;
        sys_fb_draw_rect(cur_x, cur_y, 8, 16, CLR_BG);
        sys_serial_write(char_to_str(8) + " " + char_to_str(8));
        return substr(buf, 0, len(buf) - 1);
    }
    return buf;
}

fn handle_printable(buf, c) {
    ch_str = char_to_str(c);
    sys_fb_draw_string(cur_x, cur_y, ch_str, CLR_TEXT, CLR_BG);
    cur_x = cur_x + 8;
    sys_serial_write(ch_str);
    return buf + ch_str;
}

fn harness_loop() {
    line_buf = "";
    running = true;
    draw_prompt();
    while (running) {
        c = poll_char();
        if (c < 0) {
            sys_yield();
        } else if (c == 13) {
            running = handle_newline(line_buf);
            line_buf = "";
            if (running) { draw_prompt(); }
        } else if (c == 10) {
            running = handle_newline(line_buf);
            line_buf = "";
            if (running) { draw_prompt(); }
        } else if (c == 8) {
            line_buf = handle_backspace(line_buf);
        } else if (c == 127) {
            line_buf = handle_backspace(line_buf);
        } else if (c >= 32) {
            if (c <= 126) {
                line_buf = handle_printable(line_buf, c);
            }
            0;
        }
    }
}

fn harness_main() {
    init_theme();
    init_ansi();
    draw_header();
    draw_panels();
    render_inspector();
    sys_serial_write("\n[harness] MicrOS (uOS) Sovereign Genesis Actor Online\n");
    console_writeln("MicrOS (uOS) Sovereign Genesis Actor Online", CLR_TEXT);
    console_writeln("Type 'help' for commands, 'ai <prompt>' to synthesize actors.", CLR_MUTED);
    console_newline();
    harness_loop();
}

harness_main();
