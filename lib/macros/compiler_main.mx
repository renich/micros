fn read_file(path) {
    content = sys_catalog_read(path);
    if (len(content) > 0) {
        return content;
    }
    return sys_bundle_read(path);
}

fn compiler_main(path) {
    print("Macros Compiler Pipeline Booting...");
    code = read_file(path);
    if (len(code) == 0) {
        return [];
    }
    
    print("Lexing...");
    tokens = lex(code);
    
    print("Parsing...");
    ast = parse(tokens);
    
    print("Compiling...");
    bytecode_state = compile_program(ast);
    
    print("Executing Native Chunk...");
    exec_chunk(bytecode_state[0], bytecode_state[1]);
}
