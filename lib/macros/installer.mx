// MicrOS (µOS) Sovereign Standalone System Installer
// Partitions bare-metal silicon, formats FAT32 ESP, stages bootloader, and initializes CAS.
// Zero host dependencies, autonomous and interactive modes.

fn print_banner() {
    sys_serial_write("\r\n========================================================\r\n");
    sys_serial_write("          MicrOS Sovereign Silicon Installer            \r\n");
    sys_serial_write("========================================================\r\n");
}

fn scan_drives() {
    count = sys_block_dev_count();
    if (count == 0) {
        sys_serial_write("[installer] Error: No physical storage drives detected.\r\n");
        return 0 - 1;
    }

    sys_serial_write("[installer] Discovered " + int_to_str(count) + " block device(s):\r\n");
    i = 0;
    target_idx = 0 - 1;

    while (i < count) {
        name = sys_block_dev_name(i);
        sectors = sys_block_dev_sectors(i);
        is_boot = sys_block_dev_is_boot(i);

        status = " [INSTALL TARGET]";
        if (is_boot) {
            status = " [LIVE BOOT MEDIA - PROTECTED]";
        } else if (target_idx < 0) {
            target_idx = i;
        }

        sys_serial_write("  [" + int_to_str(i) + "] " + name + " - " + int_to_str(sectors) + " sectors" + status + "\r\n");
        i = i + 1;
    }

    return target_idx;
}

fn install_esp(target_idx) {
    sys_serial_write("[installer] Step 1/5: Writing Protective MBR & GUID Partition Table...\r\n");
    gpt_ok = sys_disk_gpt_format(target_idx, 614400);
    if (gpt_ok == false) {
        sys_serial_write("[installer] Error: GPT partition table write failed.\r\n");
        return false;
    }

    sys_serial_write("[installer] Step 2/5: Formatting minimal 8.3 FAT32 EFI System Partition...\r\n");
    esp_ok = sys_disk_esp_format(target_idx);
    if (esp_ok == false) {
        sys_serial_write("[installer] Error: FAT32 ESP formatting failed.\r\n");
        return false;
    }

    sys_serial_write("[installer] Step 3/5: Synthesizing and staging PE/COFF BOOTX64.EFI...\r\n");
    stage_ok = sys_disk_esp_stage_bootloader(target_idx);
    if (stage_ok == false) {
        sys_serial_write("[installer] Error: Failed to synthesize and stage bootloader.\r\n");
        return false;
    }
    return true;
}

fn install_cas(target_idx) {
    sys_serial_write("[installer] Step 4/5: Initializing Content-Addressed Storage partition...\r\n");
    cas_ok = sys_disk_cas_format(target_idx);
    if (cas_ok == false) {
        sys_serial_write("[installer] Error: CAS partition initialization failed.\r\n");
        return false;
    }

    sys_serial_write("[installer] Step 5/5: Staging Genesis MCB bundle & committing Generation 1...\r\n");
    sys_serial_write("[installer] Deployment succeeded! Target silicon is fully sovereign.\r\n");
    sys_serial_write("[installer] Ready for activation.\r\n");
    return true;
}

fn install_to_disk(target_idx) {
    if (target_idx < 0) {
        sys_serial_write("[installer] Aborted: No valid unpartitioned install target available.\r\n");
        return false;
    }

    name = sys_block_dev_name(target_idx);
    sys_serial_write("[installer] Selected target: [" + int_to_str(target_idx) + "] " + name + "\r\n");
    if (install_esp(target_idx) == false) {
        return false;
    }
    return install_cas(target_idx);
}

fn run_installer() {
    print_banner();
    target = scan_drives();
    install_to_disk(target);
}

run_installer();
