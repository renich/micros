//Macros Stage 1 Self-Hosting Tokenizer (lexer.mx)
//Part of the MicrOS self-hosting pipeline.

fn is_digit(c) {
    if (c >= 48) {
        if (c <= 57) {
            return true;
        }
    }
    return false;
}

fn is_alpha(c) {
    if (c >= 65) {
        if (c <= 90) { return true; }
    }
    if (c >= 97) {
        if (c <= 122) { return true; }
    }
    if (c == 95) { return true; }
    return false;
}

fn process_whitespace(c) {
    if (c == 32) { return true; }
    if (c == 9) { return true; }
    if (c == 10) { return true; }
    if (c == 13) { return true; }
    return false;
}

fn process_punct(c) {
    if (c == 40) { return 21; }
    if (c == 41) { return 22; }
    if (c == 123) { return 23; }
    if (c == 125) { return 24; }
    if (c == 91) { return 25; }
    if (c == 93) { return 26; }
    if (c == 44) { return 27; }
    if (c == 59) { return 28; }
    if (c == 58) { return 29; }
    if (c == 43) { return 10; }
    if (c == 45) { return 11; }
    if (c == 42) { return 12; }
    if (c == 37) { return 33; }
    if (c == 38) { return 34; }
    if (c == 124) { return 35; }
    if (c == 94) { return 36; }
    if (c == 46) { return 40; }
    return 99;
}

fn get_punct_str(c) {
    if (c == 40) { return "("; }
    if (c == 41) { return ")"; }
    if (c == 123) { return "{"; }
    if (c == 125) { return "}"; }
    if (c == 91) { return "["; }
    if (c == 93) { return "]"; }
    if (c == 44) { return ","; }
    if (c == 59) { return ";"; }
    if (c == 58) { return ":"; }
    if (c == 43) { return "+"; }
    if (c == 45) { return "-"; }
    if (c == 42) { return "*"; }
    if (c == 37) { return "%"; }
    if (c == 38) { return "&"; }
    if (c == 124) { return "|"; }
    if (c == 94) { return "^"; }
    if (c == 46) { return "."; }
    return "";
}

fn match_keyword(lexeme) {
    if (lexeme == "fn") { return 3; }
    if (lexeme == "if") { return 5; }
    if (lexeme == "nil") { return 32; }
    if (lexeme == "else") { return 6; }
    if (lexeme == "true") { return 8; }
    if (lexeme == "while") { return 7; }
    if (lexeme == "false") { return 9; }
    if (lexeme == "return") { return 4; }
    if (lexeme == "import") { return 41; }
    if (lexeme == "export") { return 42; }
    return 0;
}

fn process_slash(source, pos, src_len) {
    if (pos + 1 < src_len) {
        if (source[pos + 1] == 47) {
            cond = true;
            new_pos = pos + 2;
            while (cond) {
                if (new_pos < src_len) {
                    if (source[new_pos] == 10) {
                        cond = false;
                    } else {
                        new_pos = new_pos + 1;
                    }
                } else {
                    cond = false;
                }
            }
            return [new_pos, [99, ""]];
        }
    }
    return [pos + 1, [13, "/"]];
}

fn process_eq(source, pos, src_len) {
    if (pos + 1 < src_len) {
        if (source[pos + 1] == 61) {
            return [pos + 2, [15, "=="]];
        }
    }
    return [pos + 1, [14, "="]];
}

fn process_bang(source, pos, src_len) {
    if (pos + 1 < src_len) {
        if (source[pos + 1] == 61) {
            return [pos + 2, [16, "!="]];
        }
    }
    return [pos + 1, [31, "!"]];
}

fn process_less(source, pos, src_len) {
    if (pos + 1 < src_len) {
        if (source[pos + 1] == 61) {
            return [pos + 2, [18, "<="]];
        }
        if (source[pos + 1] == 60) {
            return [pos + 2, [37, "<<"]];
        }
    }
    return [pos + 1, [17, "<"]];
}

fn process_greater(source, pos, src_len) {
    if (pos + 1 < src_len) {
        if (source[pos + 1] == 61) {
            return [pos + 2, [20, ">="]];
        }
        if (source[pos + 1] == 62) {
            return [pos + 2, [38, ">>"]];
        }
    }
    return [pos + 1, [19, ">"]];
}

fn is_latin1_lead(b) {
    if (b >= 194) {
        if (b <= 195) { return true; }
    }
    return false;
}

fn is_utf8_continuation(b) {
    if (b >= 128) {
        if (b <= 191) { return true; }
    }
    return false;
}

fn latin1_byte(b1, b2) {
    return ((b1 - 192) * 64) + (b2 - 128);
}

// VM string constants are Latin-1 code units (fonts, serial, keyboard agree),
// so collapse UTF-8 sequences in U+0080..U+00FF to one byte. Wider codepoints
// have no byte representation and are kept verbatim.
fn decode_unit(lexeme, i, llen) {
    b1 = lexeme[i];
    if (is_latin1_lead(b1)) {
        if (i + 1 < llen) {
            b2 = lexeme[i + 1];
            if (is_utf8_continuation(b2)) {
                return [latin1_byte(b1, b2), 2];
            }
        }
    }
    return [b1, 1];
}

fn collapse_utf8(lexeme) {
    llen = len(lexeme);
    acc = "";
    i = 0;
    while (i < llen) {
        unit = decode_unit(lexeme, i, llen);
        acc = acc + char_to_str(unit[0]);
        i = i + unit[1];
    }
    return acc;
}

fn process_string(source, pos, src_len) {
    new_pos = pos + 1;
    cond = true;
    while (cond) {
        if (new_pos < src_len) {
            c2 = source[new_pos];
            if (c2 != 34) {
                new_pos = new_pos + 1;
            } else {
                cond = false;
            }
        } else {
            cond = false;
        }
    }
    lexeme = collapse_utf8(substr(source, pos + 1, new_pos));
    new_pos = new_pos + 1;
    return [new_pos, [2, lexeme]];
}

fn process_identifier(source, pos, src_len) {
    new_pos = pos;
    cond = true;
    while (cond) {
        if (new_pos < src_len) {
            c2 = source[new_pos];
            if (is_alpha(c2)) {
                new_pos = new_pos + 1;
            } else if (is_digit(c2)) {
                new_pos = new_pos + 1;
            } else {
                cond = false;
            }
        } else {
            cond = false;
        }
    }
    lexeme = substr(source, pos, new_pos);
    tok_type = match_keyword(lexeme);
    return [new_pos, [tok_type, lexeme]];
}

fn process_number(source, pos, src_len) {
    new_pos = pos;
    cond = true;
    while (cond) {
        if (new_pos < src_len) {
            c2 = source[new_pos];
            if (is_digit(c2)) {
                new_pos = new_pos + 1;
            } else {
                cond = false;
            }
        } else {
            cond = false;
        }
    }
    lexeme = substr(source, pos, new_pos);
    return [new_pos, [1, lexeme]];
}

fn lex(source) {
        tokens = [];
    pos = 0;
    src_len = len(source);

    while (pos < src_len) {
        c = source[pos];
        
        if (process_whitespace(c)) {
            pos = pos + 1;
        } else if (c == 47) {
            res = process_slash(source, pos, src_len);
            pos = res[0];
            if (res[1][0] != 99) {
                tokens = push(tokens, res[1]);
            }
        } else if (c == 61) {
            res = process_eq(source, pos, src_len);
            pos = res[0];
            tokens = push(tokens, res[1]);
        } else if (c == 33) {
            res = process_bang(source, pos, src_len);
            pos = res[0];
            tokens = push(tokens, res[1]);
        } else if (c == 60) {
            res = process_less(source, pos, src_len);
            pos = res[0];
            tokens = push(tokens, res[1]);
        } else if (c == 62) {
            res = process_greater(source, pos, src_len);
            pos = res[0];
            tokens = push(tokens, res[1]);
        } else if (c == 34) {
            res = process_string(source, pos, src_len);
            pos = res[0];
            tokens = push(tokens, res[1]);
        } else if (is_alpha(c)) {
            res = process_identifier(source, pos, src_len);
            pos = res[0];
            tokens = push(tokens, res[1]);
        } else if (is_digit(c)) {
            res = process_number(source, pos, src_len);
            pos = res[0];
            tokens = push(tokens, res[1]);
        } else {
            ptype = process_punct(c);
            if (ptype != 99) {
                tokens = push(tokens, [ptype, get_punct_str(c)]);
                pos = pos + 1;
            } else {
                invalid_char = [];
                invalid_char = push(invalid_char, c);
                tokens = push(tokens, [99, invalid_char]);
                pos = pos + 1;
            }
        }
    }

    tokens = push(tokens, [30, ""]);
    return tokens;
}
