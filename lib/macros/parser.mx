// Macros Stage 1 Self-Hosting Recursive Descent Parser (parser.mx)
// Part of the MicrOS sovereign language self-hosting pipeline.

fn parse_call_args_acc(tokens, pos, tokens_len, args) {
    call_cond = true;
    while (call_cond) {
        if (pos >= tokens_len) { call_cond = false; }
        if (call_cond) {
            call_tok_type = tokens[pos][0];
            if (call_tok_type == 22) {
                pos = pos + 1;
                call_cond = false;
            } else if (call_tok_type == 27) {
                pos = pos + 1;
            } else {
                call_res = parse_expr(tokens, pos, tokens_len);
                pos = call_res[0];
                args = push(args, call_res[1]);
            }
        }
    }
    return [pos, args];
}

fn parse_call_args(tokens, pos, tokens_len) {
    return parse_call_args_acc(tokens, pos, tokens_len, []);
}

fn parse_index_expr(tokens, pos, tokens_len) {
    idx_res = parse_expr(tokens, pos, tokens_len);
    pos = idx_res[0];
    idx_val = idx_res[1];
    if (pos < tokens_len) {
        if (tokens[pos][0] == 26) {
            pos = pos + 1;
        }
    }
    return [pos, idx_val];
}

fn parse_postfix(tokens, pos, tokens_len, expr) {
    post_cond = true;
    while (post_cond) {
        if (pos >= tokens_len) { post_cond = false; }
        if (post_cond) {
            post_tok_type = tokens[pos][0];
            if (post_tok_type == 21) {
                pos = pos + 1;
                post_res = parse_call_args(tokens, pos, tokens_len);
                pos = post_res[0];
                expr = ["call", expr, post_res[1]];
            } else if (post_tok_type == 25) {
                pos = pos + 1;
                post_res = parse_index_expr(tokens, pos, tokens_len);
                pos = post_res[0];
                expr = ["index_get", expr, post_res[1]];
            } else {
                post_cond = false;
            }
        }
    }
    return [pos, expr];
}

fn parse_array_literal_acc(tokens, pos, tokens_len, elements) {
    arr_cond = true;
    while (arr_cond) {
        if (pos >= tokens_len) { arr_cond = false; }
        if (arr_cond) {
            arr_tok_type = tokens[pos][0];
            if (arr_tok_type == 26) {
                pos = pos + 1;
                arr_cond = false;
            } else if (arr_tok_type == 27) {
                pos = pos + 1;
            } else {
                arr_res = parse_expr(tokens, pos, tokens_len);
                pos = arr_res[0];
                elements = push(elements, arr_res[1]);
            }
        }
    }
    return [pos, ["array", elements]];
}

fn parse_array_literal(tokens, pos, tokens_len) {
    return parse_array_literal_acc(tokens, pos + 1, tokens_len, []);
}

fn parse_grouping(tokens, pos, tokens_len) {
    pos = pos + 1;
    grp_res = parse_expr(tokens, pos, tokens_len);
    pos = grp_res[0];
    if (pos < tokens_len) {
        if (tokens[pos][0] == 22) {
            pos = pos + 1;
        }
    }
    return parse_postfix(tokens, pos, tokens_len, grp_res[1]);
}

fn parse_function_expr(tokens, pos, tokens_len) {
    pos = pos + 1;
    if (pos >= tokens_len) { return [pos, ["error", "unexpected eof"]]; }
    fn_expr_name = "";
    if (tokens[pos][0] == 0) {
        fn_expr_name = tokens[pos][1];
        pos = pos + 1;
    }
    if (pos >= tokens_len) { return [pos, ["error", "unexpected eof"]]; }
    pos = pos + 1;
    fn_args_res = parse_function_args(tokens, pos, tokens_len);
    pos = fn_args_res[0];
    fn_args = fn_args_res[1];
    fn_body_res = parse_block(tokens, pos, tokens_len);
    return [fn_body_res[0], ["function_expr", fn_expr_name, fn_args, fn_body_res[1]]];
}

fn parse_primary(tokens, pos, tokens_len) {
    if (pos >= tokens_len) { return [pos, []]; }
    prim_tok = tokens[pos];
    prim_type = prim_tok[0];

    if (prim_type == 1) { return [pos + 1, ["number", prim_tok[1]]]; }
    if (prim_type == 2) { return [pos + 1, ["string", prim_tok[1]]]; }
    if (prim_type == 8) { return [pos + 1, ["boolean", true]]; }
    if (prim_type == 9) { return [pos + 1, ["boolean", false]]; }
    if (prim_type == 32) { return [pos + 1, ["nil"]]; }
    if (prim_type == 0) {
        return parse_postfix(tokens, pos + 1, tokens_len, ["identifier", prim_tok[1]]);
    }
    if (prim_type == 25) {
        prim_arr_res = parse_array_literal(tokens, pos, tokens_len);
        return parse_postfix(tokens, prim_arr_res[0], tokens_len, prim_arr_res[1]);
    }
    if (prim_type == 21) {
        return parse_grouping(tokens, pos, tokens_len);
    }
    if (prim_type == 3) {
        return parse_function_expr(tokens, pos, tokens_len);
    }
    return [pos, []];
}

fn parse_multiplicative(tokens, pos, tokens_len) {
    mult_res = parse_primary(tokens, pos, tokens_len);
    pos = mult_res[0];
    mult_left = mult_res[1];
    mult_cond = true;
    while (mult_cond) {
        if (pos >= tokens_len) { mult_cond = false; }
        if (mult_cond) {
            mult_tok_type = tokens[pos][0];
            if (mult_tok_type == 12) {
                pos = pos + 1;
                mult_sub_res = parse_primary(tokens, pos, tokens_len);
                pos = mult_sub_res[0];
                mult_left = ["binary_expr", "mul", mult_left, mult_sub_res[1]];
            } else if (mult_tok_type == 13) {
                pos = pos + 1;
                mult_sub_res = parse_primary(tokens, pos, tokens_len);
                pos = mult_sub_res[0];
                mult_left = ["binary_expr", "div", mult_left, mult_sub_res[1]];
            } else {
                mult_cond = false;
            }
        }
    }
    return [pos, mult_left];
}

fn parse_additive(tokens, pos, tokens_len) {
    add_res = parse_multiplicative(tokens, pos, tokens_len);
    pos = add_res[0];
    add_left = add_res[1];
    add_cond = true;
    while (add_cond) {
        if (pos >= tokens_len) { add_cond = false; }
        if (add_cond) {
            add_tok_type = tokens[pos][0];
            if (add_tok_type == 10) {
                pos = pos + 1;
                add_sub_res = parse_multiplicative(tokens, pos, tokens_len);
                pos = add_sub_res[0];
                add_left = ["binary_expr", "plus", add_left, add_sub_res[1]];
            } else if (add_tok_type == 11) {
                pos = pos + 1;
                add_sub_res = parse_multiplicative(tokens, pos, tokens_len);
                pos = add_sub_res[0];
                add_left = ["binary_expr", "minus", add_left, add_sub_res[1]];
            } else {
                add_cond = false;
            }
        }
    }
    return [pos, add_left];
}

fn get_cmp_op_name(tok_type) {
    if (tok_type == 15) { return "equal"; }
    if (tok_type == 16) { return "not_equal"; }
    if (tok_type == 17) { return "less"; }
    if (tok_type == 18) { return "less_equal"; }
    if (tok_type == 19) { return "greater"; }
    if (tok_type == 20) { return "greater_equal"; }
    return "";
}

fn parse_comparison(tokens, pos, tokens_len) {
    cmp_res = parse_additive(tokens, pos, tokens_len);
    pos = cmp_res[0];
    cmp_left = cmp_res[1];
    cmp_cond = true;
    while (cmp_cond) {
        if (pos >= tokens_len) { cmp_cond = false; }
        if (cmp_cond) {
            cmp_op_name = get_cmp_op_name(tokens[pos][0]);
            if (len(cmp_op_name) > 0) {
                pos = pos + 1;
                cmp_sub_res = parse_additive(tokens, pos, tokens_len);
                pos = cmp_sub_res[0];
                cmp_left = ["binary_expr", cmp_op_name, cmp_left, cmp_sub_res[1]];
            } else {
                cmp_cond = false;
            }
        }
    }
    return [pos, cmp_left];
}

fn parse_expr(tokens, pos, tokens_len) {
    return parse_comparison(tokens, pos, tokens_len);
}

fn parse_return_statement(tokens, pos, tokens_len) {
    pos = pos + 1;
    if (pos < tokens_len) {
        if (tokens[pos][0] == 28) {
            return [pos + 1, ["return_statement", ["nil"]]];
        }
    }
    ret_res = parse_expr(tokens, pos, tokens_len);
    pos = ret_res[0];
    if (pos < tokens_len) {
        if (tokens[pos][0] == 28) { pos = pos + 1; }
    }
    return [pos, ["return_statement", ret_res[1]]];
}

fn parse_assign_statement(tokens, pos, tokens_len, ident) {
    pos = pos + 2;
    asgn_res = parse_expr(tokens, pos, tokens_len);
    pos = asgn_res[0];
    if (pos < tokens_len) {
        if (tokens[pos][0] == 28) { pos = pos + 1; }
    }
    return [pos, ["assign_statement", ident, asgn_res[1]]];
}

fn parse_index_assign(tokens, pos, tokens_len, ident) {
    pos = pos + 2;
    ia_res1 = parse_expr(tokens, pos, tokens_len);
    pos = ia_res1[0];
    ia_idx = ia_res1[1];
    if (pos < tokens_len) {
        if (tokens[pos][0] == 26) { pos = pos + 1; }
    }
    if (pos < tokens_len) {
        if (tokens[pos][0] == 14) { pos = pos + 1; }
    }
    ia_res2 = parse_expr(tokens, pos, tokens_len);
    pos = ia_res2[0];
    ia_val = ia_res2[1];
    if (pos < tokens_len) {
        if (tokens[pos][0] == 28) { pos = pos + 1; }
    }
    return [pos, ["index_assign_statement", ident, ia_idx, ia_val]];
}

fn parse_else_branch(tokens, pos, tokens_len) {
    if (pos >= tokens_len) { return [pos, []]; }
    if (tokens[pos][0] == 5) {
        else_res = parse_if_statement(tokens, pos, tokens_len);
        return [else_res[0], ["block", [else_res[1]]]];
    }
    return parse_block(tokens, pos, tokens_len);
}

fn parse_if_statement(tokens, pos, tokens_len) {
    pos = pos + 1;
    if (pos < tokens_len) {
        if (tokens[pos][0] == 21) { pos = pos + 1; }
    }
    if_res = parse_expr(tokens, pos, tokens_len);
    pos = if_res[0];
    if_cond = if_res[1];
    if (pos < tokens_len) {
        if (tokens[pos][0] == 22) { pos = pos + 1; }
    }
    if_then_res = parse_block(tokens, pos, tokens_len);
    pos = if_then_res[0];
    if_then = if_then_res[1];
    if_else = [];
    if (pos < tokens_len) {
        if (tokens[pos][0] == 6) {
            pos = pos + 1;
            if_else_res = parse_else_branch(tokens, pos, tokens_len);
            pos = if_else_res[0];
            if_else = if_else_res[1];
        }
    }
    return [pos, ["if_statement", if_cond, if_then, if_else]];
}

fn parse_while_statement(tokens, pos, tokens_len) {
    pos = pos + 1;
    if (pos < tokens_len) {
        if (tokens[pos][0] == 21) { pos = pos + 1; }
    }
    wh_res = parse_expr(tokens, pos, tokens_len);
    pos = wh_res[0];
    wh_cond = wh_res[1];
    if (pos < tokens_len) {
        if (tokens[pos][0] == 22) { pos = pos + 1; }
    }
    wh_body_res = parse_block(tokens, pos, tokens_len);
    pos = wh_body_res[0];
    return [pos, ["while_statement", wh_cond, wh_body_res[1]]];
}

fn parse_statement(tokens, pos, tokens_len) {
    if (pos >= tokens_len) { return [pos, []]; }
    stmt_tok_type = tokens[pos][0];

    if (stmt_tok_type == 4) { return parse_return_statement(tokens, pos, tokens_len); }
    if (stmt_tok_type == 5) { return parse_if_statement(tokens, pos, tokens_len); }
    if (stmt_tok_type == 7) { return parse_while_statement(tokens, pos, tokens_len); }

    if (stmt_tok_type == 0) {
        if (pos + 1 < tokens_len) {
            stmt_next = tokens[pos + 1][0];
            if (stmt_next == 14) {
                return parse_assign_statement(tokens, pos, tokens_len, tokens[pos][1]);
            }
            if (stmt_next == 25) {
                return parse_index_assign(tokens, pos, tokens_len, tokens[pos][1]);
            }
        }
    }

    stmt_res = parse_expr(tokens, pos, tokens_len);
    if (stmt_res[0] == pos) { return [pos + 1, ["error", "unexpected token"]]; }
    pos = stmt_res[0];
    if (pos < tokens_len) {
        if (tokens[pos][0] == 28) { pos = pos + 1; }
    }
    return [pos, ["expr_statement", stmt_res[1]]];
}

fn parse_block_acc(tokens, pos, tokens_len, stmts) {
    blk_cond = true;
    blk_closed = false;
    while (blk_cond) {
        if (pos >= tokens_len) { blk_cond = false; }
        if (blk_cond) {
            if (tokens[pos][0] == 24) {
                pos = pos + 1;
                blk_cond = false;
                blk_closed = true;
            } else {
                blk_res = parse_statement(tokens, pos, tokens_len);
                pos = blk_res[0];
                stmts = push(stmts, blk_res[1]);
            }
        }
    }
    if (blk_closed == false) { return [pos, ["error", "missing }"]]; }
    return [pos, ["block", stmts]];
}

fn parse_block(tokens, pos, tokens_len) {
    if (pos >= tokens_len) { return [pos, ["error", "unexpected eof"]]; }
    if (tokens[pos][0] != 23) { return [pos, ["error", "expected {"]]; }
    return parse_block_acc(tokens, pos + 1, tokens_len, []);
}

fn parse_function_args_acc(tokens, pos, tokens_len, args) {
    fargs_cond = true;
    while (fargs_cond) {
        if (pos >= tokens_len) { fargs_cond = false; }
        if (fargs_cond) {
            fargs_tok = tokens[pos];
            if (fargs_tok[0] == 22) {
                pos = pos + 1;
                fargs_cond = false;
            } else if (fargs_tok[0] == 27) {
                pos = pos + 1;
            } else if (fargs_tok[0] == 0) {
                args = push(args, fargs_tok[1]);
                pos = pos + 1;
            } else {
                fargs_cond = false;
            }
        }
    }
    return [pos, args];
}

fn parse_function_args(tokens, pos, tokens_len) {
    return parse_function_args_acc(tokens, pos, tokens_len, []);
}

fn parse_function_decl(tokens, pos, tokens_len) {
    pos = pos + 1;
    if (pos >= tokens_len) { return [pos, ["error", "unexpected eof"]]; }
    fdecl_name = tokens[pos][1];
    pos = pos + 1;
    if (pos >= tokens_len) { return [pos, ["error", "unexpected eof"]]; }
    pos = pos + 1;
    fdecl_args_res = parse_function_args(tokens, pos, tokens_len);
    pos = fdecl_args_res[0];
    fdecl_args = fdecl_args_res[1];
    fdecl_body_res = parse_block(tokens, pos, tokens_len);
    return [fdecl_body_res[0], ["function_decl", fdecl_name, fdecl_args, fdecl_body_res[1]]];
}

fn parse_program_acc(tokens, pos, tokens_len, decls) {
    prog_cond = true;
    while (prog_cond) {
        if (pos >= tokens_len) { prog_cond = false; }
        if (prog_cond) {
            prog_type = tokens[pos][0];
            if (prog_type == 30) {
                prog_cond = false;
            } else if (prog_type == 3) {
                prog_res = parse_function_decl(tokens, pos, tokens_len);
                pos = prog_res[0];
                decls = push(decls, prog_res[1]);
            } else {
                prog_res = parse_statement(tokens, pos, tokens_len);
                pos = prog_res[0];
                decls = push(decls, prog_res[1]);
            }
        }
    }
    return ["program", decls];
}

fn parse(tokens) {
    return parse_program_acc(tokens, 0, len(tokens), []);
}
