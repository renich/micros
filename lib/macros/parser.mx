fn parse_primary_ident(tokens, pos, tokens_len, ident) {
    if (pos < tokens_len) {
        if (tokens[pos][0] == 21) {
            pos = pos + 1;
            call_args = [];
            cond_ident = true;
            while (cond_ident) {
                if (pos >= tokens_len) { cond_ident = false; }
                if (cond_ident) {
                    if (tokens[pos][0] == 22) {
                        pos = pos + 1;
                        cond_ident = false;
                    } else if (tokens[pos][0] == 27) {
                        pos = pos + 1;
                    } else {
                        res = parse_expr(tokens, pos, tokens_len);
                        pos = res[0];
                        call_args = push(call_args, res[1]);
                    }
                }
            }
            return [pos, ["call", ["identifier", ident], call_args]];
        }
    }
    return [pos, ["identifier", ident]];
}


fn parse_function_expr(tokens, pos, tokens_len) {
    pos = pos + 1;
    if (pos >= tokens_len) { return [pos, ["error", "unexpected eof"]]; }
    
    // Check if named or anonymous
    tok = tokens[pos];
    name = "";
    if (tok[0] == 0) { // identifier
        name = tok[1];
        pos = pos + 1;
    }
    
    if (pos >= tokens_len) { return [pos, ["error", "unexpected eof"]]; }
    pos = pos + 1; // Skip '('
    
    res_args = parse_function_args(tokens, pos, tokens_len);
    pos = res_args[0];
    args = res_args[1];
    
    res = parse_block(tokens, pos, tokens_len);
    pos = res[0];
    body = res[1];
    
    return [pos, ["function_expr", name, args, body]];
}

// Macros Stage 1 Self-Hosting Recursive Descent Parser (parser.mx)

fn parse_primary(tokens, pos, tokens_len) {
    if (pos >= tokens_len) { return [pos, []]; }
    
    // We must read directly from tokens to avoid global variable clobbering
    // since MicrOS currently treats all assigned variables as globals!
    if (tokens[pos][0] == 1) {
        return [pos + 1, ["number", tokens[pos][1]]];
    }
    if (tokens[pos][0] == 2) {
        return [pos + 1, ["string", tokens[pos][1]]];
    }
    if (tokens[pos][0] == 0) {
        return parse_primary_ident(tokens, pos + 1, tokens_len, tokens[pos][1]);
    }
    if (tokens[pos][0] == 3) {
        return parse_function_expr(tokens, pos, tokens_len);
    }
    return [pos, []];
}

fn parse_expr(tokens, pos, tokens_len) {
    res = parse_primary(tokens, pos, tokens_len);
    pos = res[0];
    left = res[1];
    
    cond = true;
    while (cond) {
        if (pos < tokens_len) {
            tok = tokens[pos];
            tok_type = tok[0];
            
            if (tok_type == 10) {
                pos = pos + 1;
                res = parse_primary(tokens, pos, tokens_len);
                pos = res[0];
                right = res[1];
                left = ["binary_expr", "plus", left, right];
            } else if (tok_type == 11) {
                pos = pos + 1;
                res = parse_primary(tokens, pos, tokens_len);
                pos = res[0];
                right = res[1];
                left = ["binary_expr", "minus", left, right];
            } else {
                cond = false;
            }
        } else {
            cond = false;
        }
    }
    
    return [pos, left];
}

fn parse_return_statement(tokens, pos, tokens_len) {
    pos = pos + 1;
    res = parse_expr(tokens, pos, tokens_len);
    pos = res[0];
    expr = res[1];
    
    if (pos < tokens_len) {
        if (tokens[pos][0] == 28) {
            pos = pos + 1;
        }
    }
    return [pos, ["return_statement", expr]];
}

fn parse_assign_statement(tokens, pos, tokens_len, ident) {
    pos = pos + 2;
    res = parse_expr(tokens, pos, tokens_len);
    pos = res[0];
    expr = res[1];
    
    if (pos < tokens_len) {
        if (tokens[pos][0] == 28) {
            pos = pos + 1;
        }
    }
    return [pos, ["assign_statement", ident, expr]];
}

fn parse_statement(tokens, pos, tokens_len) {
    if (pos >= tokens_len) { return [pos, []]; }
    tok = tokens[pos];
    tok_type = tok[0];
    
    if (tok_type == 4) {
        return parse_return_statement(tokens, pos, tokens_len);
    }
    
    if (tok_type == 0) {
        if (pos + 1 < tokens_len) {
            next_tok = tokens[pos + 1];
            if (next_tok[0] == 14) {
                return parse_assign_statement(tokens, pos, tokens_len, tok[1]);
            }
        }
    }
    
    res = parse_expr(tokens, pos, tokens_len);
    new_pos = res[0];
    expr = res[1];
    
    if (new_pos == pos) {
        pos = pos + 1;
        return [pos, ["error", "unexpected token"]];
    }
    pos = new_pos;
    
    if (pos < tokens_len) {
        if (tokens[pos][0] == 28) {
            pos = pos + 1;
        }
    }
    
    return [pos, ["expr_statement", expr]];
}

fn parse_block(tokens, pos, tokens_len) {
    if (pos >= tokens_len) { return [pos, ["error", "unexpected eof"]]; }
    if (tokens[pos][0] != 23) { return [pos, ["error", "expected {"]]; }
    pos = pos + 1;
    
    stmts = [];
    block_cond = true;
    closed = false;
    while (block_cond) {
        if (pos < tokens_len) {
            tok = tokens[pos];
            if (tok[0] == 24) {
                pos = pos + 1;
                block_cond = false;
                closed = true;
            } else {
                res = parse_statement(tokens, pos, tokens_len);
                pos = res[0];
                stmt = res[1];
                stmts = push(stmts, stmt);
            }
        } else {
            block_cond = false;
        }
    }
    
    if (closed == false) { return [pos, ["error", "missing }"]]; }
    return [pos, ["block", stmts]];
}

fn parse_function_args(tokens, pos, tokens_len) {
    args = [];
    cond = true;
    while (cond) {
        if (pos >= tokens_len) {
            cond = false;
        }
        if (cond) {
            tok2 = tokens[pos];
            if (tok2[0] == 22) { // ')'
                pos = pos + 1;
                cond = false;
            } else if (tok2[0] == 27) { // ','
                pos = pos + 1;
            } else if (tok2[0] == 0) { // identifier
                args = push(args, tok2[1]);
                pos = pos + 1;
            } else {
                cond = false;
            }
        }
    }
    return [pos, args];
}

fn parse_function_decl(tokens, pos, tokens_len) {
    pos = pos + 1;
    if (pos >= tokens_len) { return [pos, ["error", "unexpected eof"]]; }
    
    tok = tokens[pos];
    name = tok[1];
    pos = pos + 1;
    
    if (pos >= tokens_len) { return [pos, ["error", "unexpected eof"]]; }
    pos = pos + 1;
    
    res_args = parse_function_args(tokens, pos, tokens_len);
    pos = res_args[0];
    args = res_args[1];
    
    res = parse_block(tokens, pos, tokens_len);
    pos = res[0];
    body = res[1];
    
    return [pos, ["function_decl", name, args, body]];
}

fn parse(tokens) {
    pos = 0;
    tokens_len = len(tokens);
    decls = [];
    
    parse_loop_cond = true;
    while (parse_loop_cond) {
        if (pos < tokens_len) {
            tok = tokens[pos];
            if (tok[0] == 30) {
                parse_loop_cond = false;
            } else if (tok[0] == 3) {
                res = parse_function_decl(tokens, pos, tokens_len);
                pos = res[0];
                decl = res[1];
                decls = push(decls, decl);
            } else {
                res = parse_statement(tokens, pos, tokens_len);
                pos = res[0];
                decl = res[1];
                decls = push(decls, decl);
            }
        } else {
            parse_loop_cond = false;
        }
    }
    
    return ["program", decls];
}
