// MicrOS (µOS) Sovereign Desktop Environment (desk.mx)
// Pure Macros multi-window glass workspace running over the vector compositor ABI.
// SPEC-TECH-DESK-001: Manages multi-window layout, status telemetry bar,
// task switching, terminal, AI studio, file manager, and load monitor.

fn init_colors() {
    CLR_BG = 0;              // Pitch black
    CLR_HEADER_BG = 856343;  // Dark charcoal: 0x0D1117
    CLR_BORDER = 2238254;    // Hairline graphite: 0x22272E
    CLR_TEXT = 15132390;     // Crisp white: 0xE6EDF3
    CLR_MUTED = 8226192;     // Slate gray: 0x7D8590
    CLR_ACCENT = 5809919;    // Ice sapphire: 0x58A6FF
    CLR_GREEN = 4176208;     // Emerald green: 0x3FB950
    CLR_WARN = 13801762;     // Amber: 0xD29922
    CLR_WIN_BG = 988444;     // Deep obsidian window bg: 0x0F141C
}

fn state_name(st) {
    if (st == 1) { return "ready"; }
    if (st == 2) { return "running"; }
    if (st == 3) { return "paused"; }
    if (st == 4) { return "faulted"; }
    if (st == 5) { return "stopped"; }
    return "inactive";
}

fn pad_right_16(str) {
    pad = 16 - len(str);
    res = str;
    while (pad > 0) {
        res = res + " ";
        pad = pad - 1;
    }
    return res;
}

fn draw_desktop_bar(active_tab) {
    sys_fb_draw_rect(0, 0, 1280, 24, CLR_HEADER_BG);
    sys_fb_draw_string(16, 4, "uOS Sovereign Desktop", CLR_TEXT, CLR_HEADER_BG);

    // Tab buttons
    t1_fg = CLR_MUTED; if (active_tab == 1) { t1_fg = CLR_ACCENT; }
    t2_fg = CLR_MUTED; if (active_tab == 2) { t2_fg = CLR_ACCENT; }
    t3_fg = CLR_MUTED; if (active_tab == 3) { t3_fg = CLR_ACCENT; }
    t4_fg = CLR_MUTED; if (active_tab == 4) { t4_fg = CLR_ACCENT; }

    sys_fb_draw_string(240, 4, "[1:Terminal]", t1_fg, CLR_HEADER_BG);
    sys_fb_draw_string(370, 4, "[2:AI Studio]", t2_fg, CLR_HEADER_BG);
    sys_fb_draw_string(500, 4, "[3:Files]", t3_fg, CLR_HEADER_BG);
    sys_fb_draw_string(610, 4, "[4:Telemetry]", t4_fg, CLR_HEADER_BG);

    // Telemetry section
    actors_s = "Actors: " + int_to_str(sys_actor_count());
    faults_s = "Faults: " + int_to_str(sys_fault_count());
    sys_fb_draw_string(920, 4, actors_s, CLR_TEXT, CLR_HEADER_BG);
    sys_fb_draw_string(1030, 4, faults_s, CLR_GREEN, CLR_HEADER_BG);
    sys_fb_draw_string(1150, 4, "[ES-LATAM]", CLR_WARN, CLR_HEADER_BG);
    sys_fb_draw_rect(0, 24, 1280, 1, CLR_BORDER);
}

fn populate_term_window(win_id) {
    sys_window_draw_rect(win_id, 0, 0, 600, 340, CLR_WIN_BG);
    sys_window_draw_string(win_id, 16, 16, "uOS MicroShell Terminal (Session #1)", CLR_ACCENT, CLR_WIN_BG);
    sys_window_draw_string(win_id, 16, 36, "Freestanding x86_64 Substrate | Zero-libc", CLR_MUTED, CLR_WIN_BG);
    sys_window_draw_string(win_id, 16, 60, "msh> uname -a", CLR_TEXT, CLR_WIN_BG);
    sys_window_draw_string(win_id, 16, 80, "MicrOS 0.15.0-dev x86_64 uOS/Freestanding", CLR_GREEN, CLR_WIN_BG);
    sys_window_draw_string(win_id, 16, 110, "msh> make test", CLR_TEXT, CLR_WIN_BG);
    sys_window_draw_string(win_id, 16, 130, "[PASS] 244/244 unit tests passed (100% trace)", CLR_GREEN, CLR_WIN_BG);
    sys_window_draw_string(win_id, 16, 160, "msh> status", CLR_TEXT, CLR_WIN_BG);
    sys_window_draw_string(win_id, 16, 180, "Kernel: Stable | IPC: SPSC Rings | VirtIO: Active", CLR_TEXT, CLR_WIN_BG);
    sys_window_draw_string(win_id, 16, 210, "msh> ", CLR_GREEN, CLR_WIN_BG);
    sys_window_draw_rect(win_id, 56, 210, 8, 14, CLR_GREEN);
}

fn populate_ai_window(win_id) {
    sys_window_draw_rect(win_id, 0, 0, 600, 340, CLR_WIN_BG);
    sys_window_draw_string(win_id, 16, 16, "uOS Autonomous Pair-Programming Studio (harness)", CLR_ACCENT, CLR_WIN_BG);
    sys_window_draw_string(win_id, 16, 36, "Resident AI: Gemini 3.8 Flash | Protocol: Sovereign ABI", CLR_MUTED, CLR_WIN_BG);
    sys_window_draw_string(win_id, 16, 60, "harness> Welcome back, Renich.", CLR_TEXT, CLR_WIN_BG);
    sys_window_draw_string(win_id, 16, 80, "Available tools: run_command, view_file, list_dir, etc.", CLR_MUTED, CLR_WIN_BG);
    sys_window_draw_string(win_id, 16, 110, "user> /status", CLR_ACCENT, CLR_WIN_BG);
    sys_window_draw_string(win_id, 16, 130, "* Agent: Online | Memory: 15MB budget | Latency: 42ms", CLR_TEXT, CLR_WIN_BG);
    sys_window_draw_string(win_id, 16, 160, "user> show active capabilities", CLR_ACCENT, CLR_WIN_BG);
    sys_window_draw_string(win_id, 16, 180, "* CSpace 0: storage.ALL | actor.EXEC | net.CONNECT", CLR_GREEN, CLR_WIN_BG);
    sys_window_draw_string(win_id, 16, 210, "harness> ", CLR_ACCENT, CLR_WIN_BG);
    sys_window_draw_rect(win_id, 80, 210, 8, 14, CLR_ACCENT);
}

fn render_files_header(win_id) {
    sys_window_draw_rect(win_id, 0, 0, 600, 340, CLR_WIN_BG);
    sys_window_draw_string(win_id, 16, 16, "Sovereign Workspace File Navigator (CAS)", CLR_ACCENT, CLR_WIN_BG);
    sys_window_draw_string(win_id, 16, 36, "Root Merkle Hash: BLAKE3 Content-Addressed", CLR_MUTED, CLR_WIN_BG);
    sys_window_draw_rect(win_id, 16, 52, 568, 1, CLR_BORDER);
    sys_window_draw_string(win_id, 16, 56, "Name             Size (B)   Merkle BLAKE3 Hash", CLR_MUTED, CLR_WIN_BG);
    sys_window_draw_rect(win_id, 16, 72, 568, 1, CLR_BORDER);
}

fn populate_files_window(win_id) {
    render_files_header(win_id);
    fy = 80;
    entries = [
        "init.mx          1645       a7f3b82109cd4e12",
        "msh.mx           18357      b821e45901fa239d",
        "harness.mx       34900      f901ab3284cd1234",
        "desk.mx          8450       c384d1290fae4512",
        "installer.mx     9210       d412e873910abc23",
        "rebuild.mx       4120       e523f984021bcd34",
        "vedit.mx         12400      0134a095132cde45"
    ];
    ei = 0;
    elen = len(entries);
    while (ei < elen) {
        sys_window_draw_string(win_id, 16, fy, entries[ei], CLR_TEXT, CLR_WIN_BG);
        fy = fy + 18;
        ei = ei + 1;
    }
}

fn render_telem_header(win_id) {
    sys_window_draw_rect(win_id, 0, 0, 600, 340, CLR_WIN_BG);
    sys_window_draw_string(win_id, 16, 16, "System Performance & Fault Telemetry Monitor", CLR_ACCENT, CLR_WIN_BG);
    sys_window_draw_string(win_id, 16, 36, "Hardware Supervisor: Ring 0 Isolation Active", CLR_MUTED, CLR_WIN_BG);
    sys_window_draw_rect(win_id, 16, 52, 568, 1, CLR_BORDER);
    sys_window_draw_string(win_id, 16, 56, "ID   Actor Name       State      Faults   Heap Pages", CLR_MUTED, CLR_WIN_BG);
    sys_window_draw_rect(win_id, 16, 72, 568, 1, CLR_BORDER);
}

fn populate_telem_window(win_id) {
    render_telem_header(win_id);
    ty = 80;
    aid = 0;
    while (aid < 6) {
        ast = sys_actor_state(aid);
        if (ast >= 0) {
            nm = pad_right_16(sys_actor_name(aid));
            st_s = pad_right_16(state_name(ast));
            line = " " + int_to_str(aid) + "   " + nm + " " + st_s + " 0        16";
            clr = CLR_TEXT;
            if (ast == 2) { clr = CLR_GREEN; }
            sys_window_draw_string(win_id, 16, ty, line, clr, CLR_WIN_BG);
            ty = ty + 18;
        }
        aid = aid + 1;
    }
    ty = ty + 12;
    sys_window_draw_rect(win_id, 16, ty, 568, 1, CLR_BORDER);
    ty = ty + 8;
    sys_window_draw_string(win_id, 16, ty, "Microkernel WCET: < 12us | Interrupt Latency: Jitter-Free", CLR_MUTED, CLR_WIN_BG);
}

fn poll_input() {
    c = sys_serial_read();
    if (c >= 0) { return c; }
    return sys_kbd_read();
}

fn desk_main() {
    init_colors();
    sys_fb_clear(CLR_BG);
    draw_desktop_bar(1);

    // Create 4 tiled application windows
    w_term = sys_window_create("Terminal", 600, 340, 0);
    w_ai = sys_window_create("AI Studio", 600, 340, 0);
    w_files = sys_window_create("Workspace Files", 600, 340, 0);
    w_telem = sys_window_create("System Monitor", 600, 340, 0);

    // Populate contents
    populate_term_window(w_term);
    populate_ai_window(w_ai);
    populate_files_window(w_files);
    populate_telem_window(w_telem);

    active_tab = 1;
    sys_window_focus(w_term);
    sys_compositor_flush();

    running = 1;
    while (running == 1) {
        c = poll_input();
        if (c == 49) { // '1'
            active_tab = 1; sys_window_focus(w_term); draw_desktop_bar(1); sys_compositor_flush();
        } else if (c == 50) { // '2'
            active_tab = 2; sys_window_focus(w_ai); draw_desktop_bar(2); sys_compositor_flush();
        } else if (c == 51) { // '3'
            active_tab = 3; sys_window_focus(w_files); draw_desktop_bar(3); sys_compositor_flush();
        } else if (c == 52) { // '4'
            active_tab = 4; sys_window_focus(w_telem); draw_desktop_bar(4); sys_compositor_flush();
        } else if (c == 9) { // TAB
            active_tab = active_tab + 1;
            if (active_tab > 4) { active_tab = 1; }
            if (active_tab == 1) { sys_window_focus(w_term); }
            if (active_tab == 2) { sys_window_focus(w_ai); }
            if (active_tab == 3) { sys_window_focus(w_files); }
            if (active_tab == 4) { sys_window_focus(w_telem); }
            draw_desktop_bar(active_tab);
            sys_compositor_flush();
        } else if (c == 113) { // 'q'
            running = 0;
        } else if (c == 27) { // ESC
            running = 0;
        } else {
            sys_yield();
        }
    }

    // Cleanup windows
    sys_window_close(w_term);
    sys_window_close(w_ai);
    sys_window_close(w_files);
    sys_window_close(w_telem);
    sys_fb_clear(CLR_BG);
    return 0;
}

desk_main();
