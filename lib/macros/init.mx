// MicrOS (µOS) System Supervisor (Actor 0 / PID 1)
// Runs as the root genesis actor under CSpace 0.
// Initializes system environment and launches msh.mx.

print("uOS 0.15.0: System supervisor online.");

fn supervisor_loop(child_id) {
    while (true) {
        st = sys_actor_state(child_id);
        if (st == 5) {
            print("[init] Shell exited. Respawning...");
            msh_src = sys_bundle_read("msh.mx");
            child_id = sys_actor_spawn_code("msh", msh_src);
        } else if (st == 4) {
            print("[init] Shell faulted! Respawning...");
            msh_src = sys_bundle_read("msh.mx");
            child_id = sys_actor_spawn_code("msh", msh_src);
        } else if (st < 0) {
            print("[init] Shell missing. Respawning...");
            msh_src = sys_bundle_read("msh.mx");
            child_id = sys_actor_spawn_code("msh", msh_src);
        }
        sys_yield();
    }
}

fn boot_init() {
    msh_src = sys_bundle_read("msh.mx");
    if (len(msh_src) == 0) {
        print("[init] Fatal: msh.mx not found in genesis bundle.");
        return 0;
    }
    msh_id = sys_actor_spawn_code("msh", msh_src);
    if (msh_id < 0) {
        print("[init] Fatal: Failed to spawn shell.");
        return 0;
    }
    confirmed = sys_cas_confirm_boot();
    if (confirmed) {
        print("[init] Trial generation confirmed. Promoted to STABLE.");
    }
    supervisor_loop(msh_id);
    return 0;
}

boot_init();
