// Macros Self-Hosted Bytecode Compiler (Phase 5)

fn op_constant() { return 0; }
fn op_add() { return 1; }
fn op_sub() { return 2; }
fn op_print() { return 3; }
fn op_return() { return 4; }
fn op_get_global() { return 5; }
fn op_set_global() { return 6; }
fn op_get_local() { return 7; }
fn op_set_local() { return 8; }
fn op_pop() { return 9; }
fn op_call() { return 10; }
fn op_jump() { return 11; }
fn op_jump_if_false() { return 12; }
fn op_loop() { return 13; }
fn op_build_array() { return 14; }
fn op_closure() { return 26; }

fn init_compiler() {
    // state: [chunk_code, chunk_constants, locals, scope_depth]
    return [[], [], [], 0];
}

fn add_constant(state, val) {
    constants = state[1];
    idx = len(constants);
    new_constants = push(constants, val);
    return [[state[0], new_constants, state[2], state[3]], idx];
}

fn write_byte(state, byte) {
    new_code = push(state[0], byte);
    return [[new_code, state[1], state[2], state[3]], state];
}

fn compile_number(state, num_str) {
    num = str_to_int(num_str);
    res = add_constant(state, num);
    state = res[0];
    idx = res[1];
    
    res = write_byte(state, op_constant());
    state = res[0];
    
    high_byte = bit_and(bit_shr(idx, 8), 255);
    low_byte = bit_and(idx, 255);
    
    res = write_byte(state, high_byte);
    state = res[0];
    res = write_byte(state, low_byte);
    state = res[0];
    
    return state;
}

fn resolve_local(state, name) {
    locals = state[2];
    idx = len(locals) - 1;
    while (idx >= 0) {
        local = locals[idx];
        if (local[0] == name) {
            return idx;
        }
        idx = idx - 1;
    }
    return 0 - 1;
}

fn compile_expr(state, node) {
    if (len(node) == 0) { return state; }
    type = node[0];
    
    if (type == "number") {
        return compile_number(state, node[1]);
    }
    if (type == "string") {
        res = add_constant(state, node[1]);
        state = res[0];
        idx = res[1];
        res = write_byte(state, op_constant());
        state = res[0];
        res = write_byte(state, bit_and(bit_shr(idx, 8), 255));
        state = res[0];
        res = write_byte(state, bit_and(idx, 255));
        state = res[0];
        return state;
    }
    if (type == "identifier") {
        name = node[1];
        local_idx = resolve_local(state, name);
        if (local_idx >= 0) {
            res = write_byte(state, op_get_local());
            state = res[0];
            res = write_byte(state, local_idx);
            state = res[0];
            return state;
        } else {
            res = add_constant(state, name);
            state = res[0];
            idx = res[1];
            res = write_byte(state, op_get_global());
            state = res[0];
            res = write_byte(state, bit_and(bit_shr(idx, 8), 255));
            state = res[0];
            res = write_byte(state, bit_and(idx, 255));
            state = res[0];
            return state;
        }
    }
    if (type == "call") {
        state = compile_expr(state, node[1]); // callee
        args = node[2];
        args_len = len(args);
        expr_i = 0;
        while (expr_i < args_len) {
            state = compile_expr(state, args[expr_i]);
            expr_i = expr_i + 1;
        }
        res = write_byte(state, op_call());
        state = res[0];
        res = write_byte(state, args_len);
        state = res[0];
        return state;
    }
    
    if (type == "binary_expr") {
        op = node[1];
        state = compile_expr(state, node[2]); // left
        state = compile_expr(state, node[3]); // right
        if (op == "plus") {
            res = write_byte(state, op_add());
            state = res[0];
        } else if (op == "minus") {
            res = write_byte(state, op_sub());
            state = res[0];
        }
        return state;
    }
    
    // Fallback for unhandled expressions
    return state;
}

fn compile_statement(state, node) {
    type = node[0];
    

    if (type == "assign_statement") {
        ident_name_assign = node[1];
        state = compile_expr(state, node[2]);
        
        local_idx_assign = resolve_local(state, ident_name_assign);
        if (local_idx_assign >= 0) {
            res = write_byte(state, op_set_local());
            state = res[0];
            res = write_byte(state, local_idx_assign);
            state = res[0];
        } else {
            // Because Macros doesn't have `push` natively mapped to array, wait... does it?
            // The compiler uses `locals = state[2]`. We can just use `push`.
            // Wait, does the compiler environment have `push`? 
            // In vm.zig, we mapped `push` as a global native function!
            locals_arr = state[2];
            locals_arr = push(locals_arr, [ident_name_assign, state[3]]);
            state[2] = locals_arr;
            
            // It's the last local
            new_idx = len(locals_arr) - 1;
            res = write_byte(state, op_set_local());
            state = res[0];
            res = write_byte(state, new_idx);
            state = res[0];
        }
        return state;
    }

    if (type == "return_statement") {
        state = compile_expr(state, node[1]);
        res = write_byte(state, op_return());
        state = res[0];
        return state;
    }
    
    if (type == "expr_statement") {
        inner = node[1];
        if (inner[0] == "call") {
            callee = inner[1];
            if (callee[0] == "identifier") {
                if (callee[1] == "print") {
                    call_args = inner[2];
                    state = compile_expr(state, call_args[0]);
                    res = write_byte(state, op_print());
                    state = res[0];
                    return state;
                }
            }
        }
        
        state = compile_expr(state, node[1]);
        res = write_byte(state, op_pop());
        state = res[0];
        return state;
    }
    
    if (type == "print") {
        state = compile_expr(state, node[1]);
        res = write_byte(state, op_print());
        state = res[0];
        return state;
    }
    
    return state;
}

fn compile_block(state, stmts) {
    stmts_len = len(stmts);
    block_i = 0;
    while (block_i < stmts_len) {
        state = compile_statement(state, stmts[block_i]);
        block_i = block_i + 1;
    }
    return state;
}

fn compile_function(state, name, args, body) {
    res = emit_jump(state, op_jump());
    state = res[0];
    jump_idx = res[1];

    code_arr = state[0];
    ip_start = len(code_arr);

    // Compile body
    stmts = body[1];
    state = compile_block(state, stmts);
    
    // Add return nil
    res = add_constant(state, []);
    state = res[0];
    idx = res[1];
    res = write_byte(state, op_constant());
    state = res[0];
    res = write_byte(state, bit_and(bit_shr(idx, 8), 255));
    state = res[0];
    res = write_byte(state, bit_and(idx, 255));
    state = res[0];
    res = write_byte(state, op_return());
    state = res[0];
    
    state = patch_jump(state, jump_idx);
    
    // Call build_function
    res = add_constant(state, "build_function");
    state = res[0];
    idx = res[1];
    res = write_byte(state, op_get_global()); state = res[0];
    res = write_byte(state, bit_and(bit_shr(idx, 8), 255)); state = res[0];
    res = write_byte(state, bit_and(idx, 255)); state = res[0];
    
    res = add_constant(state, name);
    state = res[0];
    name_idx = res[1];
    res = write_byte(state, op_constant()); state = res[0];
    res = write_byte(state, bit_and(bit_shr(name_idx, 8), 255)); state = res[0];
    res = write_byte(state, bit_and(name_idx, 255)); state = res[0];
    
    res = add_constant(state, len(args));
    state = res[0];
    idx = res[1];
    res = write_byte(state, op_constant()); state = res[0];
    res = write_byte(state, bit_and(bit_shr(idx, 8), 255)); state = res[0];
    res = write_byte(state, bit_and(idx, 255)); state = res[0];
    
    res = add_constant(state, 0);
    state = res[0];
    idx = res[1];
    res = write_byte(state, op_constant()); state = res[0];
    res = write_byte(state, bit_and(bit_shr(idx, 8), 255)); state = res[0];
    res = write_byte(state, bit_and(idx, 255)); state = res[0];
    
    res = add_constant(state, 0); // upvalue_count
    state = res[0];
    idx = res[1];
    res = write_byte(state, op_constant()); state = res[0];
    res = write_byte(state, bit_and(bit_shr(idx, 8), 255)); state = res[0];
    res = write_byte(state, bit_and(idx, 255)); state = res[0];
    
    res = add_constant(state, ip_start);
    state = res[0];
    idx = res[1];
    res = write_byte(state, op_constant()); state = res[0];
    res = write_byte(state, bit_and(bit_shr(idx, 8), 255)); state = res[0];
    res = write_byte(state, bit_and(idx, 255)); state = res[0];
    
    res = write_byte(state, op_call()); state = res[0];
    res = write_byte(state, 5); state = res[0];
    
    res = write_byte(state, op_closure()); state = res[0];
    
    res = write_byte(state, op_set_global()); state = res[0];
    res = write_byte(state, bit_and(bit_shr(name_idx, 8), 255)); state = res[0];
    res = write_byte(state, bit_and(name_idx, 255)); state = res[0];
    
    res = write_byte(state, op_pop()); state = res[0];
    
    return state;
}

fn compile_program(ast) {
    state = init_compiler();
    if (ast[0] == "program") {
        decls = ast[1];
        decls_len = len(decls);
        prog_i = 0;
        while (prog_i < decls_len) {
            decl = decls[prog_i];
            if (decl[0] == "function_decl") {
                state = compile_function(state, decl[1], decl[2], decl[3]);
            } else if (decl[0] == "expr_statement") {
                state = compile_statement(state, decl);
            } else if (decl[0] == "print") {
                state = compile_statement(state, decl);
            }
            prog_i = prog_i + 1;
        }
    }
    
    // Add return nil for the main chunk
    res = add_constant(state, []);
    state = res[0];
    idx = res[1];
    res = write_byte(state, op_constant());
    state = res[0];
    res = write_byte(state, bit_and(bit_shr(idx, 8), 255));
    state = res[0];
    res = write_byte(state, bit_and(idx, 255));
    state = res[0];
    res = write_byte(state, op_return());
    state = res[0];
    
    return state;
}

fn emit_jump(state, instruction) {
    res = write_byte(state, instruction);
    state = res[0];
    
    code = state[0];
    jump_idx = len(code);
    
    res = write_byte(state, 0);
    state = res[0];
    res = write_byte(state, 0);
    state = res[0];
    
    return [state, jump_idx];
}

fn patch_jump(state, jump_idx) {
    code = state[0];
    len_code = len(code);
    diff = len_code - jump_idx - 2;
    code[jump_idx] = bit_and(bit_shr(diff, 8), 255);
    code[jump_idx + 1] = bit_and(diff, 255);
    return state;
}

fn compile_if_expr(state, node) {
    cond = node[1];
    then_br = node[2];
    else_br = node[3];
    
    state = compile_expr(state, cond);
    
    res = emit_jump(state, op_jump_if_false());
    state = res[0];
    then_jump = res[1];
    
    state = compile_expr(state, then_br);
    
    if (len(else_br) > 0) {
        res = emit_jump(state, op_jump());
        state = res[0];
        else_jump = res[1];
        
        state = patch_jump(state, then_jump);
        state = compile_expr(state, else_br);
        state = patch_jump(state, else_jump);
    } else {
        res = emit_jump(state, op_jump());
        state = res[0];
        else_jump = res[1];
        
        state = patch_jump(state, then_jump);
        
        // Push nil
        res = add_constant(state, make_nil());
        state = res[0];
        idx = res[1];
        res = write_byte(state, op_constant());
        state = res[0];
        res = write_byte(state, bit_and(bit_shr(idx, 8), 255));
        state = res[0];
        res = write_byte(state, bit_and(idx, 255));
        state = res[0];
        
        state = patch_jump(state, else_jump);
    }
    return state;
}

