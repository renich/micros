// Macros Stage 1 Self-Hosted Bytecode Compiler (compiler.mx)
// Part of the MicrOS sovereign language self-hosting pipeline.

fn op_constant() { return 0; }
fn op_add() { return 1; }
fn op_sub() { return 2; }
fn op_print() { return 3; }
fn op_return() { return 4; }
fn op_get_global() { return 5; }
fn op_set_global() { return 6; }
fn op_get_local() { return 7; }
fn op_set_local() { return 8; }
fn op_pop() { return 9; }
fn op_call() { return 10; }
fn op_jump() { return 11; }
fn op_jump_if_false() { return 12; }
fn op_loop() { return 13; }
fn op_build_array() { return 14; }
fn op_index_get() { return 15; }
fn op_index_set() { return 16; }
fn op_equal() { return 20; }
fn op_not_equal() { return 21; }
fn op_less() { return 22; }
fn op_greater() { return 23; }
fn op_less_equal() { return 24; }
fn op_greater_equal() { return 25; }
fn op_closure() { return 26; }
fn op_get_upvalue() { return 27; }
fn op_set_upvalue() { return 28; }
fn op_close_upvalue() { return 29; }

fn init_compiler() {
    return [[], [], [], 0, [], []];
}

fn add_constant(state, val) {
    constants = state[1];
    idx = len(constants);
    new_constants = push(constants, val);
    return [[state[0], new_constants, state[2], state[3], state[4], state[5]], idx];
}

fn write_byte(state, byte) {
    new_code = push(state[0], byte);
    return [[new_code, state[1], state[2], state[3], state[4], state[5]], state];
}

fn emit_constant(state, val) {
    res = add_constant(state, val);
    state = res[0];
    idx = res[1];
    res = write_byte(state, op_constant());
    state = res[0];
    res = write_byte(state, bit_and(bit_shr(idx, 8), 255));
    state = res[0];
    res = write_byte(state, bit_and(idx, 255));
    return res[0];
}

fn emit_jump(state, instruction) {
    res = write_byte(state, instruction);
    state = res[0];
    jump_idx = len(state[0]);
    res = write_byte(state, 0);
    state = res[0];
    res = write_byte(state, 0);
    return [res[0], jump_idx];
}

fn patch_jump(state, jump_idx) {
    code = state[0];
    diff = len(code) - jump_idx - 2;
    code[jump_idx] = bit_and(bit_shr(diff, 8), 255);
    code[jump_idx + 1] = bit_and(diff, 255);
    return state;
}

fn resolve_local(state, name) {
    locals = state[2];
    idx = len(locals) - 1;
    while (idx >= 0) {
        local = locals[idx];
        if (local[0] == name) {
            return idx;
        }
        idx = idx - 1;
    }
    return 0 - 1;
}

fn find_upvalue(upvalues, is_local, index) {
    u_idx = 0;
    u_len = len(upvalues);
    while (u_idx < u_len) {
        u = upvalues[u_idx];
        if (u[0] == is_local) {
            if (u[1] == index) {
                return u_idx;
            }
        }
        u_idx = u_idx + 1;
    }
    return 0 - 1;
}

fn add_upvalue(state, is_local, index, name) {
    existing = find_upvalue(state[4], is_local, index);
    if (existing >= 0) {
        return [state, existing];
    }
    new_u = push(state[4], [is_local, index, name]);
    new_idx = len(new_u) - 1;
    new_state = [state[0], state[1], state[2], state[3], new_u, state[5]];
    return [new_state, new_idx];
}

fn add_ctx_upvalue(ctx, is_local, index, name) {
    existing = find_upvalue(ctx[1], is_local, index);
    if (existing >= 0) {
        return [ctx, existing];
    }
    new_u = push(ctx[1], [is_local, index, name]);
    new_idx = len(new_u) - 1;
    return [[ctx[0], new_u, ctx[2]], new_idx];
}

fn resolve_in_ctx(ctx, name) {
    if (len(ctx) == 0) {
        return [ctx, 0 - 1, 0];
    }
    c_locals = ctx[0];
    c_idx = len(c_locals) - 1;
    while (c_idx >= 0) {
        if (c_locals[c_idx][0] == name) {
            return [ctx, c_idx, 1];
        }
        c_idx = c_idx - 1;
    }
    enc = ctx[2];
    if (len(enc) == 0) {
        return [ctx, 0 - 1, 0];
    }
    enc_res = resolve_in_ctx(enc, name);
    ctx = [ctx[0], ctx[1], enc_res[0]];
    enc_idx = enc_res[1];
    if (enc_idx >= 0) {
        is_loc = enc_res[2];
        add_res = add_ctx_upvalue(ctx, is_loc, enc_idx, name);
        return [add_res[0], add_res[1], 0];
    }
    return [ctx, 0 - 1, 0];
}

fn resolve_upvalue(state, name) {
    enclosing = state[5];
    if (len(enclosing) == 0) {
        return [state, 0 - 1];
    }
    enc_locals = enclosing[0];
    enc_idx = len(enc_locals) - 1;
    while (enc_idx >= 0) {
        if (enc_locals[enc_idx][0] == name) {
            return add_upvalue(state, 1, enc_idx, name);
        }
        enc_idx = enc_idx - 1;
    }
    parent_enc = enclosing[2];
    if (len(parent_enc) == 0) {
        return [state, 0 - 1];
    }
    enc_res = resolve_in_ctx(parent_enc, name);
    enc_idx = enc_res[1];
    if (enc_idx >= 0) {
        is_loc = enc_res[2];
        enclosing = [enclosing[0], enclosing[1], enc_res[0]];
        add_res = add_ctx_upvalue(enclosing, is_loc, enc_idx, name);
        enclosing = add_res[0];
        parent_u_idx = add_res[1];
        state = [state[0], state[1], state[2], state[3], state[4], enclosing];
        return add_upvalue(state, 0, parent_u_idx, name);
    }
    enclosing = [enclosing[0], enclosing[1], enc_res[0]];
    state = [state[0], state[1], state[2], state[3], state[4], enclosing];
    return [state, 0 - 1];
}

fn emit_binary_op(state, op) {
    if (op == "plus") { return write_byte(state, op_add())[0]; }
    if (op == "minus") { return write_byte(state, op_sub())[0]; }
    if (op == "equal") { return write_byte(state, op_equal())[0]; }
    if (op == "not_equal") { return write_byte(state, op_not_equal())[0]; }
    if (op == "less") { return write_byte(state, op_less())[0]; }
    if (op == "greater") { return write_byte(state, op_greater())[0]; }
    if (op == "less_equal") { return write_byte(state, op_less_equal())[0]; }
    if (op == "greater_equal") { return write_byte(state, op_greater_equal())[0]; }
    return state;
}

fn compile_identifier(state, name) {
    local_idx = resolve_local(state, name);
    if (local_idx >= 0) {
        res = write_byte(state, op_get_local());
        state = res[0];
        res = write_byte(state, local_idx);
        return res[0];
    }
    up_res = resolve_upvalue(state, name);
    state = up_res[0];
    up_idx = up_res[1];
    if (up_idx >= 0) {
        res = write_byte(state, op_get_upvalue());
        state = res[0];
        res = write_byte(state, up_idx);
        return res[0];
    }
    res = add_constant(state, name);
    state = res[0];
    idx = res[1];
    res = write_byte(state, op_get_global());
    state = res[0];
    res = write_byte(state, bit_and(bit_shr(idx, 8), 255));
    state = res[0];
    res = write_byte(state, bit_and(idx, 255));
    return res[0];
}

fn compile_call_args(state, args, arg_i, args_len) {
    while (arg_i < args_len) {
        state = compile_expr(state, args[arg_i]);
        arg_i = arg_i + 1;
    }
    return state;
}

fn compile_call(state, callee, args) {
    state = compile_expr(state, callee);
    args_len = len(args);
    state = compile_call_args(state, args, 0, args_len);
    res = write_byte(state, op_call());
    state = res[0];
    res = write_byte(state, args_len);
    return res[0];
}

fn compile_array_elems(state, elements, elem_i, elem_len) {
    while (elem_i < elem_len) {
        state = compile_expr(state, elements[elem_i]);
        elem_i = elem_i + 1;
    }
    return state;
}

fn compile_array(state, elements) {
    elem_len = len(elements);
    state = compile_array_elems(state, elements, 0, elem_len);
    res = write_byte(state, op_build_array());
    state = res[0];
    res = write_byte(state, elem_len);
    return res[0];
}

fn compile_expr(state, node) {
    if (len(node) == 0) { return state; }
    type = node[0];

    if (type == "number") { return emit_constant(state, str_to_int(node[1])); }
    if (type == "string") { return emit_constant(state, node[1]); }
    if (type == "boolean") { return emit_constant(state, make_bool(node[1])); }
    if (type == "nil") { return emit_constant(state, make_nil()); }
    if (type == "identifier") { return compile_identifier(state, node[1]); }
    if (type == "call") { return compile_call(state, node[1], node[2]); }
    if (type == "array") { return compile_array(state, node[1]); }

    if (type == "index_get") {
        state = compile_expr(state, node[1]);
        state = compile_expr(state, node[2]);
        res = write_byte(state, op_index_get());
        return res[0];
    }
    if (type == "binary_expr") {
        state = compile_expr(state, node[2]);
        state = compile_expr(state, node[3]);
        return emit_binary_op(state, node[1]);
    }
    return state;
}

fn compile_assign_statement(state, name, val_node) {
    state = compile_expr(state, val_node);
    local_idx = resolve_local(state, name);
    if (local_idx >= 0) {
        res = write_byte(state, op_set_local());
        state = res[0];
        res = write_byte(state, local_idx);
        state = res[0];
    } else {
        up_res = resolve_upvalue(state, name);
        state = up_res[0];
        up_idx = up_res[1];
        if (up_idx >= 0) {
            res = write_byte(state, op_set_upvalue());
            state = res[0];
            res = write_byte(state, up_idx);
            state = res[0];
        } else {
            res = add_constant(state, name);
            state = res[0];
            idx = res[1];
            res = write_byte(state, op_set_global());
            state = res[0];
            res = write_byte(state, bit_and(bit_shr(idx, 8), 255));
            state = res[0];
            res = write_byte(state, bit_and(idx, 255));
            state = res[0];
        }
    }
    res = write_byte(state, op_pop());
    return res[0];
}

fn compile_index_assign_statement(state, name, idx_expr, val_expr) {
    state = compile_expr(state, val_expr);
    state = compile_expr(state, ["identifier", name]);
    state = compile_expr(state, idx_expr);
    res = write_byte(state, op_index_set());
    state = res[0];
    res = write_byte(state, op_pop());
    return res[0];
}

fn compile_if_statement(state, cond, then_br, else_br) {
    state = compile_expr(state, cond);
    res = emit_jump(state, op_jump_if_false());
    state = res[0];
    then_jump = res[1];

    state = compile_block(state, then_br[1]);

    if (len(else_br) > 0) {
        res = emit_jump(state, op_jump());
        state = res[0];
        else_jump = res[1];

        state = patch_jump(state, then_jump);
        state = compile_block(state, else_br[1]);
        state = patch_jump(state, else_jump);
    } else {
        state = patch_jump(state, then_jump);
    }
    return state;
}

fn compile_while_statement(state, cond, body) {
    loop_start = len(state[0]);

    state = compile_expr(state, cond);
    res = emit_jump(state, op_jump_if_false());
    state = res[0];
    exit_jump = res[1];

    state = compile_block(state, body[1]);

    loop_offset = len(state[0]) + 3 - loop_start;
    res = write_byte(state, op_loop());
    state = res[0];
    res = write_byte(state, bit_and(bit_shr(loop_offset, 8), 255));
    state = res[0];
    res = write_byte(state, bit_and(loop_offset, 255));
    state = res[0];

    return patch_jump(state, exit_jump);
}

fn compile_expr_statement(state, inner) {
    if (inner[0] == "call") {
        callee = inner[1];
        if (callee[0] == "identifier") {
            if (callee[1] == "print") {
                print_args = inner[2];
                state = compile_expr(state, print_args[0]);
                res = write_byte(state, op_print());
                return res[0];
            }
        }
    }
    state = compile_expr(state, inner);
    res = write_byte(state, op_pop());
    return res[0];
}

fn compile_statement(state, node) {
    type = node[0];

    if (type == "assign_statement") {
        return compile_assign_statement(state, node[1], node[2]);
    }
    if (type == "index_assign_statement") {
        return compile_index_assign_statement(state, node[1], node[2], node[3]);
    }
    if (type == "if_statement") {
        return compile_if_statement(state, node[1], node[2], node[3]);
    }
    if (type == "while_statement") {
        return compile_while_statement(state, node[1], node[2]);
    }
    if (type == "function_decl") {
        return compile_function(state, node[1], node[2], node[3]);
    }
    if (type == "return_statement") {
        state = compile_expr(state, node[1]);
        res = write_byte(state, op_return());
        return res[0];
    }
    if (type == "expr_statement") {
        return compile_expr_statement(state, node[1]);
    }
    return state;
}

fn compile_block_stmts(state, stmts, block_i, stmts_len) {
    while (block_i < stmts_len) {
        state = compile_statement(state, stmts[block_i]);
        block_i = block_i + 1;
    }
    return state;
}

fn compile_block(state, stmts) {
    return compile_block_stmts(state, stmts, 0, len(stmts));
}

fn emit_closure_descriptors(state, upvalues) {
    u_i = 0;
    u_cnt = len(upvalues);
    while (u_i < u_cnt) {
        u_desc = upvalues[u_i];
        res = write_byte(state, u_desc[0]); state = res[0];
        res = write_byte(state, u_desc[1]); state = res[0];
        u_i = u_i + 1;
    }
    return state;
}

fn emit_store_function(state, name) {
    local_idx = resolve_local(state, name);
    if (local_idx >= 0) {
        res = write_byte(state, op_set_local()); state = res[0];
        res = write_byte(state, local_idx); state = res[0];
    } else {
        res = add_constant(state, name);
        state = res[0];
        name_idx = res[1];
        res = write_byte(state, op_set_global()); state = res[0];
        res = write_byte(state, bit_and(bit_shr(name_idx, 8), 255)); state = res[0];
        res = write_byte(state, bit_and(name_idx, 255)); state = res[0];
    }
    res = write_byte(state, op_pop());
    return res[0];
}

fn emit_call_build_function(state, name, args_len, upvalues, ip_start) {
    res = add_constant(state, "build_function");
    state = res[0];
    idx = res[1];
    res = write_byte(state, op_get_global()); state = res[0];
    res = write_byte(state, bit_and(bit_shr(idx, 8), 255)); state = res[0];
    res = write_byte(state, bit_and(idx, 255)); state = res[0];

    state = emit_constant(state, name);
    state = emit_constant(state, args_len);
    state = emit_constant(state, args_len + 1);
    state = emit_constant(state, len(upvalues));
    state = emit_constant(state, ip_start);

    res = write_byte(state, op_call()); state = res[0];
    res = write_byte(state, 5); state = res[0];
    res = write_byte(state, op_closure()); state = res[0];

    state = emit_closure_descriptors(state, upvalues);
    return emit_store_function(state, name);
}

fn compile_function_body(state, body, name, args_len, ip_start, jump_idx, old_scope) {
    state = compile_block(state, body[1]);

    state = emit_constant(state, make_nil());
    res = write_byte(state, op_return());
    state = res[0];

    fn_upvalues = state[4];
    updated_ctx = state[5];

    restored_locals = updated_ctx[0];
    restored_upvalues = updated_ctx[1];
    restored_enclosing = updated_ctx[2];

    state = [state[0], state[1], restored_locals, old_scope, restored_upvalues, restored_enclosing];
    state = patch_jump(state, jump_idx);

    return emit_call_build_function(state, name, args_len, fn_upvalues, ip_start);
}

fn compile_function(state, name, args, body) {
    res = emit_jump(state, op_jump());
    state = res[0];
    jump_idx = res[1];

    ip_start = len(state[0]);

    fn_locals = [[name, 1]];
    args_len = len(args);
    arg_i = 0;
    while (arg_i < args_len) {
        fn_locals = push(fn_locals, [args[arg_i], 1]);
        arg_i = arg_i + 1;
    }

    old_locals = state[2];
    old_scope = state[3];
    old_upvalues = state[4];
    old_enclosing = state[5];
    parent_ctx = [old_locals, old_upvalues, old_enclosing];

    state = [state[0], state[1], fn_locals, old_scope + 1, [], parent_ctx];
    return compile_function_body(state, body, name, args_len, ip_start, jump_idx, old_scope);
}

fn compile_prog_decls(state, decls, prog_i, decls_len) {
    while (prog_i < decls_len) {
        decl = decls[prog_i];
        if (decl[0] == "function_decl") {
            state = compile_function(state, decl[1], decl[2], decl[3]);
        } else {
            state = compile_statement(state, decl);
        }
        prog_i = prog_i + 1;
    }
    return state;
}

fn compile_program(ast) {
    state = init_compiler();
    if (ast[0] == "program") {
        decls = ast[1];
        state = compile_prog_decls(state, decls, 0, len(decls));
    }

    state = emit_constant(state, make_nil());
    res = write_byte(state, op_return());
    return res[0];
}
